local DeleteDefs={{id="Accessory",name="Accessories"},{id="Weapon",name="Weapons"},{id="Warrior",name="Warriors"},{id="Pet",name="Heroes / Pets"}}
function F.deletePlan(category)
    local inv=X.InventoryService
    local equip=gs("EquipService")
    local multi=gs("MultiplierService")
    local pd=Lib.PlayerData
    assert(inv and equip and multi and pd,"Inventory services/player data unavailable")
    local systems=inv:GetSystems()
    local system=systems[category]
    assert(system and system.Storage and type(system.Data)=="function","Unsupported inventory category")
    local items=pd[system.List]
    assert(type(items)=="table","Inventory list unavailable")
    local cap=multi.Storage(LP,category)
    assert(type(cap)=="number" and cap==cap and cap>0 and cap<math.huge,"Invalid inventory capacity")
    local data=system.Data()
    assert(type(data)=="table","Item definitions unavailable")
    local rarities=gd("RarityData")
    local plan={ids={},count=0,capacity=cap,protected=0,unknown=0,list=system.List}
    for uid,item in pairs(items) do
        plan.count=plan.count+1
        local ok,eligible=pcall(function()
            if type(uid)~="string" or type(item)~="table" then return false end
            if item.Locked or item.Equipped or item.DontChange then return false end
            if equip:IsEquipped(pd,category,uid) or inv:IsCosmetic(pd,category,uid) then return false end
            if system.IsBusy and system.IsBusy(pd,uid) then return false end
            local def=data[item.Id or uid]
            local rarity=def and def.Rarity
            if S.AutoSecret and S.SecretAccessory and category=="Accessory" and rarity=="Secret" then return false end
            if type(rarity)~="string" or not rarities[rarity] then return nil end
            return type(S.DeleteRarities[category])=="table" and table.find(S.DeleteRarities[category],rarity)~=nil
        end)
        if not ok or eligible==nil then plan.unknown=plan.unknown+1
        elseif eligible then plan.ids[#plan.ids+1]=uid
        else plan.protected=plan.protected+1 end
    end
    table.sort(plan.ids)
    return plan
end
function F.previewDelete()
    if not S.Ready or S.UIHydrating then return end
    local lines={}
    for _,def in ipairs(DeleteDefs) do
        if S.DeleteCategories[def.id]==true then
            local ok,p=pcall(F.deletePlan,def.id)
            lines[#lines+1]=ok and (def.name..": "..p.count.."/"..p.capacity.." | matching "..#p.ids.." | unknown "..p.unknown..((S.DeleteTrigger=="Any bag size" or p.count>=p.capacity) and (" | eligible now; "..(S.DeleteScope=="All matching items" and "all matching" or tostring(S.DeleteCount).." per cycle")) or " | waits until full")) or (def.name..": "..tostring(p))
        end
    end
    safeDesc(UI.DeleteStatus,#lines>0 and table.concat(lines,"\n") or "Select categories and rarities first. Nothing deleted.")
end
function F.deleteTick(now)
    if not S.Run or not S.Ready or not S.DeleteArmed then return end
    if S.DeletePending then
        local pending=S.DeletePending;local items=Lib.PlayerData and Lib.PlayerData[pending.list]
        if type(items)~="table" then return end
        local remain=0;for _,uid in ipairs(pending.ids) do if items[uid]~=nil then remain=remain+1 end end
        if remain==0 then
            S.DeletePending=nil;ENV.ShiroNekoDeletePending=nil
            safeDesc(UI.DeleteStatus,"Confirmed removal of "..#pending.ids.." items; continuing selected cycle.")
        elseif now-pending.at>=10 then
            S.DeleteArmed=false;writeConfig();if UI.DeleteMaster then UI.DeleteMaster:Set(false) end
            safeDesc(UI.DeleteStatus,"Delete unconfirmed; paused with pending request retained. Check inventory, then turn Auto Delete ON to continue.")
        end
        return
    end
    if not S.DeleteCycle then
        if now-(S.LastDeleteCheck or -math.huge)<5 then return end
        S.LastDeleteCheck=now;local cycle={}
        for _,def in ipairs(DeleteDefs) do
            if S.DeleteCategories[def.id] then
                local ok,plan=pcall(F.deletePlan,def.id)
                if ok and (S.DeleteTrigger=="Any bag size" or plan.count>=plan.capacity) then
                    local ids={};local limit=S.DeleteScope=="All matching items" and #plan.ids or math.min(S.DeleteCount,#plan.ids)
                    for i=1,limit do ids[#ids+1]=plan.ids[i] end
                    if #ids>0 then cycle[#cycle+1]={category=def.id,ids=ids} end
                elseif not ok then safeDesc(UI.DeleteStatus,tostring(plan)) end
            end
        end
        if #cycle==0 then return end
        S.DeleteCycle=cycle;ENV.ShiroNekoDeleteCycle=cycle
    end
    local entry=S.DeleteCycle[1]
    if not entry then S.DeleteCycle=nil;ENV.ShiroNekoDeleteCycle=nil;return end
    if not S.DeleteCategories[entry.category] then table.remove(S.DeleteCycle,1);return end
    local ok,plan=pcall(F.deletePlan,entry.category)
    if not ok then safeDesc(UI.DeleteStatus,tostring(plan));return end
    local allowed={};for _,id in ipairs(plan.ids) do allowed[id]=true end
    local ids={}
    while #entry.ids>0 and #ids<10 do
        local id=table.remove(entry.ids,1);if allowed[id] then ids[#ids+1]=id end
    end
    if #entry.ids==0 then table.remove(S.DeleteCycle,1) end
    if #ids==0 then return end
    local pending={ids=ids,list=plan.list,category=entry.category,at=now}
    S.DeletePending=pending;ENV.ShiroNekoDeletePending=pending
    fire("InventorySystem","Delete",entry.category,Lib:Encode(ids))
    safeDesc(UI.DeleteStatus,"Delete requested: "..#ids.." items from "..entry.category.."; waiting for confirmation.")
end

