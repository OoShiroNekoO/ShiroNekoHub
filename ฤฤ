function F.openMagicKnightPanel(target)
    target=target or "Magic Knight Hub"
    if S.MagicKnightOpenBusy then notify("Magic Knight", "A native panel is already opening") return end
    S.MagicKnightOpenBusy=true
    local names
    if target=="Magic Knight Hub" then
        names={"MagicKnightHub","MagicKnight","SystemSelector"}
    elseif target=="Clover Awakening" then
        names={"CloverAwakening","Awakening","SystemSelector"}
    else
        names={"GrimoireStats","MagicStats","Grimoire Stats","SystemSelector"}
    end
    local opened,used=openNativeGui(names)
    if not opened then
        S.MagicKnightOpenBusy=false
        safeDesc(UI.MagicKnightStatus,"Cannot open native panel: "..tostring(used))
        notify("Magic Knight",tostring(used))
        return false
    end
    safeDesc(UI.MagicKnightStatus,"Opened native "..tostring(used).."; looking for "..target..".")
    task.spawn(function()
        local deadline=os.clock()+2.5
        local selectedHub=(target=="Magic Knight Hub")
        local clicked=false
        while S.Run and os.clock()<deadline do
            if not selectedHub then
                local hub=findGuiButton({"Magic Knight Hub"})
                if hub then
                    local sent=activateGuiButton(hub)
                    if sent then selectedHub=true;task.wait(.2) end
                end
            end
            local button=findGuiButton({target})
            if button then
                local sent,how=activateGuiButton(button)
                clicked=sent
                if sent then safeDesc(UI.MagicKnightStatus,"Opened "..target.." via native button ("..how..").") end
                break
            end
            task.wait(.1)
        end
        if not clicked then
            safeDesc(UI.MagicKnightStatus,"Native "..tostring(used).." opened. Button "..target.." was not found; use the visible in-game panel.")
        end
        S.MagicKnightOpenBusy=false
    end)
    notify("Magic Knight",target.." requested")
    return true
end

-- v1.4.49: SystemSelectorService quest action: Available -> Give (accept), Ready -> Check (claim).
function F.claimMagicKnightQuests(manual)
    local rows=F.magicKnightQuestRows()
    local api=F.questApi()
    if #rows==0 or not api then
        local why=#rows==0 and "No Magic Knight quest entries replicated yet." or "QuestData state API unavailable; nothing sent."
        safeDesc(UI.MagicKnightQuestStatus,why)
        if manual then notify("Magic Knight Quests",why) end
        return 0
    end
    local given,claimed,progress=0,0,0
    for _,row in ipairs(rows) do
        local ok,state=pcall(api.GetState,Lib.PlayerData,row.kind,row.id)
        if ok and state=="Ready" then
            if fire("QuestSystem","Check",row.kind,row.id) then claimed=claimed+1 end
        elseif ok and state=="Available" then
            if fire("QuestSystem","Give",row.kind,row.id) then given=given+1 end
        elseif ok and state=="Progress" then progress=progress+1 end
    end
    S.LastMagicKnightQuest=os.clock()
    local text=string.format("Accepted %d | claimed %d | in progress %d. Waiting for replicated quest state.",given,claimed,progress)
    safeDesc(UI.MagicKnightQuestStatus,text)
    if manual then notify("Magic Knight Quests",text) end
    return given+claimed
end

