function F.trialPreemptStep()
    if not F.trialUrgent() then return end
    F.stopTrialWalk()
    if LP:GetAttribute("Teleporting")==true then
        safeDesc(UI.TrialPriorityStatus,"Trial open: waiting for current teleport to finish.");return
    end
    local button=F.returnButton()
    if not button and not F.modeOwnsMovement() then
        if S.ItemBusy then return end
        -- Respect an already-sent mode request until its bounded pending window ends.
        if os.clock()<S.ModePendingUntil then return end
        safeDesc(UI.TrialPriorityStatus,"Trial open: entering ahead of other activities.")
        F.enterTimeTrial(false);return
    end
    if not button then
        local pg=LP:FindFirstChild("PlayerGui")
        local gui=pg and pg:FindFirstChild("Gamemode")
        local content=gui and gui:FindFirstChild("Content")
        button=content and content:FindFirstChild("Leave")
    end
    if not button or not button:IsA("GuiButton") then
        safeDesc(UI.TrialPriorityStatus,"Trial open: mode Leave button unavailable. Exit the current mode to continue.");return
    end
    local parent=button
    while parent and parent~=LP:FindFirstChild("PlayerGui") do
        if parent:IsA("GuiObject") and not parent.Visible then return end
        if parent:IsA("ScreenGui") and not parent.Enabled then return end
        parent=parent.Parent
    end
    local interactable=true;pcall(function() interactable=button.Interactable end)
    if not button.Active or not interactable then return end
    local state=S.TrialExitAttempt
    local mode=tostring(LP:GetAttribute("InMode") or LP:GetAttribute("Mode"))
    if not state or state.button~=button or state.mode~=mode then
        state={button=button,mode=mode,tries=0,last=-math.huge};S.TrialExitAttempt=state
    end
    if state.tries>=3 then
        safeDesc(UI.TrialPriorityStatus,"Trial open: exit unconfirmed after 3 attempts. Check Leave/confirmation in game.");return
    end
    if os.clock()-state.last<3 then return end
    local signalFire=ENV.firesignal or firesignal
    local connections=ENV.getconnections or getconnections
    if type(signalFire)~="function" or type(connections)~="function" then
        safeDesc(UI.TrialPriorityStatus,"Trial open: executor cannot activate Leave. Exit manually to continue.");return
    end
    local signal
    for _,candidate in ipairs({button.MouseButton1Click,button.Activated}) do
        local ok,list=pcall(connections,candidate)
        if ok and type(list)=="table" then
            for _,connection in ipairs(list) do
                local readable,enabled=pcall(function() return connection.Enabled end)
                if readable and enabled==true then signal=candidate;break end
            end
        end
        if signal then break end
    end
    if not signal then return end
    state.last=os.clock();state.tries=state.tries+1
    local ok,err=pcall(signalFire,signal)
    safeDesc(UI.TrialPriorityStatus,ok and "Leave/Return sent: waiting for mode exit before Trial." or tostring(err))
end

