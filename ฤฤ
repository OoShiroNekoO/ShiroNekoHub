local function fire(...)
    if not S.Run or not S.Ready or not Lib.Remote then return false,"client_not_ready" end
    local a=table.pack(...)
    local key=tostring(a[1]).."/"..tostring(a[2]).."/"..tostring(a[3]).."/"..tostring(a[4])
    local now=os.clock()
    local cooldown=(a[2]=="Toggle" and 2) or (a[1]=="QuestSystem" and 5) or 1
    if S.LastCalls[key] and now-S.LastCalls[key]<cooldown then return false,"local_cooldown" end
    S.LastCalls[key]=now
    local ok,e=pcall(function() Lib.Remote:Fire(table.unpack(a,1,a.n)) end)
    if not ok then
        S.LastError=tostring(e)
        warn("[ShiroNeko Remote]",e)
    end
    return ok,ok and "dispatched_not_confirmed" or tostring(e)
end

-- Toggle requests are edge-triggered; do not infer OFF from missing PlayerData.
local function toggleNativeAuto(id, want)
    if not S.Run or not S.Ready or S.UIHydrating or type(want)~="boolean" then return false end
    local def=X.AutoData and X.AutoData[id]
    local states=Lib.PlayerData and Lib.PlayerData.AutoSettings
    if type(def)~="table" or def.Kind~="Toggle" or type(states)~="table" then return false end
    S.BuiltInAutos[id]=want
    save()
    local pending=S.NativeAutoPending and S.NativeAutoPending[id]
    if pending then
        if states[id]==pending.want then S.NativeAutoPending[id]=nil
        else return false end -- refresh/restart after an unconfirmed request; never blind-retry a toggle.
    end
    if (states[id]==true)==want then return true end
    S.NativeAutoPending=S.NativeAutoPending or {}
    S.NativeAutoPending[id]={want=want,at=os.clock()}
    local sent=fire("AutoSystem","Toggle",id)
    if not sent then S.NativeAutoPending[id]=nil end
    return sent
end

