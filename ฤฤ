function F.buffActivity()
    if F.returnButton() then return "Results" end
    if LP:GetAttribute("Teleporting")==true then return "Travelling" end
    for _,mode in ipairs({"Time Trial","Raid","Portal","Invasion","Tower"}) do
        if F.inMode(mode) then return mode end
    end
    local h=hum();if not h or h.Health<=0 then return "Waiting" end
    local a=F.currentActivity()
    if a=="Farm" then return "Farming" end
    if a=="SecretFarm" then return "Secret collection" end
    return "Idle"
end
function F.buffRuleTick(now)
    if not S.Run or not S.Ready then return end
    local pd=Lib.PlayerData
    if not pd or type(pd.Consumables)~="table" or type(pd.ConsumablePaused)~="table" then
        safeDesc(UI.BuffStatus,"Waiting for consumable timers / pause states.");return
    end
    local pending=S.BuffPending
    if pending then
        if (tonumber(pd.Consumables[pending.id]) or 0)<=0 or (pd.ConsumablePaused[pending.id]==true)==pending.paused then
            S.BuffPending=nil;ENV.ShiroNekoBuffPending=nil
        else
            safeDesc(UI.BuffStatus,now-pending.at>=10 and ("Unconfirmed: "..pending.id..". Inspect game, then Reset pending toggle.") or ("Waiting for "..pending.id.." confirmation."))
            return
        end
    end
    if not S.AutoBuffModes then safeDesc(UI.BuffStatus,"OFF. Current game pause states are left unchanged.");return end
    if now<(S.BuffNext or 0) then return end
    S.BuffNext=now+.5
    local defs=gd("ItemData.Consumable")
    if type(defs)~="table" or not next(defs) then safeDesc(UI.BuffStatus,"Waiting for Potion / Juice definitions.");return end
    local activity=F.buffActivity();local ids={};local controlled=0
    for id,seconds in pairs(pd.Consumables) do
        local def=defs[id]
        if def and (def.Category=="Potion" or def.Category=="Juice") and type(def.Base)=="string" and S.BuffEnabled[def.Base]==true and tonumber(seconds) and tonumber(seconds)>0 then
            ids[#ids+1]=id
        end
    end
    table.sort(ids)
    for _,id in ipairs(ids) do
        local def=defs[id];local modes=S.BuffModes[def.Base]
        local desired=not (type(modes)=="table" and table.find(modes,activity)~=nil)
        controlled=controlled+1
        if (pd.ConsumablePaused[id]==true)~=desired then
            local state={id=id,paused=desired,at=now}
            S.BuffPending=state;ENV.ShiroNekoBuffPending=state
            fire("ConsumableSystem","Pause",id)
            safeDesc(UI.BuffStatus,(desired and "Pausing " or "Resuming ")..tostring(def.Name or id).." | "..activity)
            return -- global game debounce: one request per worker tick
        end
    end
    safeDesc(UI.BuffStatus,activity.." | "..controlled.." existing buff timers matched. No bottles consumed; empty timers need normal Auto Use or manual use.")
end
