-- v1.4.49: QuestData.GetState(pd,type,id) -> "Ready" means claimable (decompiled AutoController /
-- UIController.Quests). Types with ClaimAt are claimed at their NPC and are skipped here.
function F.questApi()
    local q=gd("QuestData")
    if type(q)=="table" and type(q.GetState)=="function" and type(q.GetTypeInfo)=="function" then return q end
end
function F.claimQuests()
    local q=Lib.PlayerData and Lib.PlayerData.Quests
    local api=F.questApi()
    if type(q)~="table" or not api then return 0 end
    local sent=0
    for typ,list in pairs(q) do
        local okInfo,info=pcall(api.GetTypeInfo,typ)
        local okOpen,open=true,true
        if type(api.IsOpen)=="function" then okOpen,open=pcall(api.IsOpen,typ,LP) end
        if type(list)=="table" and okInfo and type(info)=="table" and not info.ClaimAt and okOpen and open then
            for id in pairs(list) do
                local okState,state=pcall(api.GetState,Lib.PlayerData,typ,id)
                if okState and state=="Ready" and fire("QuestSystem","Check",typ,id) then sent=sent+1 end
            end
        end
    end
    return sent
end

function F.claimAll()
    local pd=Lib.PlayerData or {}
    fire("AchievementSystem","ClaimAll",true) fire("LikeRewardSystem","ClaimAll",true)
    for id in pairs(X.BattlepassData or {}) do fire("BattlepassSystem","ClaimAll",id,true) end
    if X.IndexService and type(pd.IndexTask)=="table" then
        for id,st in pairs(pd.IndexTask) do
            for typ in pairs(X.IndexService.TaskTypes or {}) do
                local ok,p=pcall(function() return X.IndexService.GetTaskProgress(LP,typ,id) end)
                if type(st)=="table" and not st[typ] and ok and p then fire("IndexSystem","Claim",id,typ,true) end
            end
        end
    end
    if X.DailyRewardService and type(pd.DailyRewards)=="table" then
        local ok,day=pcall(function() return X.DailyRewardService.CurrentDay() end)
        if ok then for id in pairs(X.DailyRewardData or {}) do
            local st=pd.DailyRewards[id]
            local can=type(st)=="table" and type(st.Claimed)=="table" and not st.Claimed[tostring(day)]
            if can then
                local ok2,r=pcall(function() return X.DailyRewardService.HasPlaytime(id,day,st.Time) end)
                if ok2 and r then fire("DailyRewardSystem","Claim",id,day,true) end
            end
        end end
    end
    if type(pd.TimeRewards)=="table" then
        for id,d in pairs(X.TimeRewardData or {}) do
            local st=pd.TimeRewards[id]
            if type(st)=="table" and type(st.Claimed)=="table" and type(d)=="table" and type(st.Time)=="number" then for idx,r in pairs(d.Rewards or {}) do if type(r)=="table" and type(r.Time)=="number" and not st.Claimed[idx] and r.Time<=st.Time then fire("TimeRewardSystem","Claim",id,idx,true) end end end
        end
    end
    local now=(Lib.Replicated and Lib.Replicated:GetAttribute("Time")) or os.time()
    for id,d in pairs(X.ChestData or {}) do
        local at=pd.Delay and pd.Delay[id]
        if at and now>=at then
            local can=true
            if type(d.CanClaim)=="function" then local ok,r=pcall(d.CanClaim,LP); can=ok and r==true end
            if can then fire("ChestSystem","Claim",id,true) end
        end
    end
    F.claimQuests() notify("Claims","Claim requests sent")
end

