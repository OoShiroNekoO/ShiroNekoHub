local function gd2(a,b) local dx,dz=a.x-b.x,a.z-b.z return dx*dx+dz*dz end
-- Smallest circle containing every point (incremental Welzl; exact, n is small).
function F.minCircle(pts)
    local c
    local function inside(p) return c~=nil and gd2(p,c)<=c.r*c.r+1e-6 end
    local function two(a,b) return {x=(a.x+b.x)/2,z=(a.z+b.z)/2,r=math.sqrt(gd2(a,b))/2} end
    local function three(a,b,q)
        local bx,bz=b.x-a.x,b.z-a.z
        local cx,cz=q.x-a.x,q.z-a.z
        local d=2*(bx*cz-bz*cx)
        if math.abs(d)<1e-9 then
            local p1,p2=a,b
            if gd2(a,q)>gd2(p1,p2) then p1,p2=a,q end
            if gd2(b,q)>gd2(p1,p2) then p1,p2=b,q end
            return two(p1,p2)
        end
        local b2,c2=bx*bx+bz*bz,cx*cx+cz*cz
        local ux,uz=(cz*b2-bz*c2)/d,(bx*c2-cx*b2)/d
        return {x=a.x+ux,z=a.z+uz,r=math.sqrt(ux*ux+uz*uz)}
    end
    for i=1,#pts do
        local p=pts[i]
        if not inside(p) then
            c={x=p.x,z=p.z,r=0}
            for j=1,i-1 do
                local q=pts[j]
                if not inside(q) then
                    c=two(p,q)
                    for k=1,j-1 do if not inside(pts[k]) then c=three(p,q,pts[k]) end end
                end
            end
        end
    end
    return c
end
function F.coverCount(pts,center,radius)
    local n,r2=0,radius*radius
    for _,p in ipairs(pts) do if gd2(p,center)<=r2+1e-6 then n=n+1 end end
    return n
end
-- Best circle centre for radius R: all points if they fit, otherwise the spot covering the most
-- points (candidates: each point and both radius-R circles through every close pair), re-centred.
function F.bestCircle(pts,radius,anchor)
    if #pts==0 then return nil end
    local all=F.minCircle(pts)
    if all and all.r<=radius then return {x=all.x,z=all.z,count=#pts,spread=all.r} end
    local r2=radius*radius
    local cands={}
    for i=1,#pts do cands[#cands+1]={x=pts[i].x,z=pts[i].z} end
    for i=1,#pts do for j=i+1,#pts do
        local a,b=pts[i],pts[j]
        local dd=gd2(a,b)
        if dd>1e-9 and dd<=4*r2 then
            local d=math.sqrt(dd);local h=math.sqrt(math.max(0,r2-dd/4))
            local mx,mz=(a.x+b.x)/2,(a.z+b.z)/2
            local ox,oz=-(b.z-a.z)/d*h,(b.x-a.x)/d*h
            cands[#cands+1]={x=mx+ox,z=mz+oz};cands[#cands+1]={x=mx-ox,z=mz-oz}
        end
    end end
    local best
    for _,c in ipairs(cands) do
        local cover,hasAnchor={},false
        for _,p in ipairs(pts) do if gd2(p,c)<=r2+1e-6 then cover[#cover+1]=p;if p==anchor then hasAnchor=true end end end
        local score=#cover+(hasAnchor and .5 or 0)
        if not best or score>best.score then best={score=score,cover=cover,x=c.x,z=c.z} end
    end
    local mc=F.minCircle(best.cover)
    if mc and mc.r<=radius then best.x,best.z,best.spread=mc.x,mc.z,mc.r end
    best.count=#best.cover
    return best
end
-- Move only when a spot covers MORE targets than where we already stand; otherwise stay put.
-- Inner radius (85%) when choosing a spot leaves room for moving mobs; 95% when judging "here".
function F.groupMove(pts,anchor,rootPos,radius)
    local best=F.bestCircle(pts,radius*.85,anchor)
    if not best then return nil,nil end
    local here=F.coverCount(pts,{x=rootPos.X,z=rootPos.Z},radius*.95)
