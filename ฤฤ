function F.raidHostObserve()
    local state=S.RaidHostPending
    if not state or not S.Run or not S.Ready then return end
    local now=os.clock();local room=F.raidHostOwnRoom()
    if room and room:GetAttribute("MapId")==state.map and room:GetAttribute("Diff")==state.diff then
        if state.room~=room then F.raidTrace("room_observed",state.map.." | "..state.diff) end
        state.room=room
        if F.inMode("Raid") and tostring(LP:GetAttribute("InMode"))==room.Name then S.RaidResultOwned=true end
        local status=room:GetAttribute("Status")
        if type(status)=="string" and status~="" and status~="Opened" then
            state.transitioned=true
            safeDesc(UI.RaidHostStatus,"Owned Raid status: "..status..". Waiting until the room closes.")
            return
        end
        -- Start only the room belonging to this create, while actually inside it.
        local inRoom=tostring(LP:GetAttribute("InMode"))==room.Name and F.inMode("Raid")
        if status=="Opened" and not inRoom and not F.modeOwnsMovement() and not state.joinAt
            and S.AutoRaidHost and S.ActivityAllowed.Raid~=false and not F.trialUrgent() and not F.returnButton()
            and not S.ItemBusy and LP:GetAttribute("Teleporting")~=true and not F.raidNativeEnabled() then
            state.joinAt=now
            local sent,reason=fire("GamemodeSystem","Join","Raid",LP.UserId)
            F.raidTrace("join_request",reason)
            if not sent then F.raidBlock("Join submission unconfirmed: "..tostring(reason),state);return end
            safeDesc(UI.RaidHostStatus,"Joining existing owned Raid; no new ticket spent.")
            return
        end
        if not S.AutoRaidHost or S.ActivityAllowed.Raid==false or F.trialUrgent() or F.returnButton()
            or LP:GetAttribute("Teleporting")==true or S.ItemBusy or F.raidNativeEnabled() then return end
        if status=="Opened" and inRoom and not state.startAt then
            state.startAt=now
            -- v1.4.49: UIController.Gamemode Start button sends Start(ModeId) only.
            -- Start(mode,true) is AutoController's form, sent only while native Auto is ON.
            local sent,reason=fire("GamemodeSystem","Start","Raid")
            F.raidTrace("start_request",reason)
            if not sent then F.raidBlock("Start submission unconfirmed: "..tostring(reason),state);return end
            safeDesc(UI.RaidHostStatus,sent and "Start requested once; waiting for Raid state change." or "Start unconfirmed; no repeated request.")
            return
        end
        if now-(state.startAt or state.at)<25 then return end
    elseif state.room and not state.room.Parent then
        S.RaidHostPending=nil;ENV.ShiroNekoRaidHostPending=nil;S.RaidHostNextCheck=now+2
        safeDesc(UI.RaidHostStatus,"Previous owned room closed. Rechecking remaining tickets.")
        return
    elseif now-state.at<25 then return end
    -- Room identity, not just a decreasing item counter, confirms creation.
    local reason=state.startAt and "Start unconfirmed: owned room did not change from Opened within the wait period."
        or state.joinAt and "Join unconfirmed: owned room exists but entry was not observed within the wait period."
        or "Create unconfirmed: no matching owned room observed within 25 seconds. Server acceptance is unknown."
    if room and (room:GetAttribute("MapId")~=state.map or room:GetAttribute("Diff")~=state.diff) then
        reason="Owned room metadata differs from the requested map/difficulty; no second ticket request sent."
    end
    F.raidBlock(reason,state)
    S.RaidHostPending=nil;ENV.ShiroNekoRaidHostPending=nil
end

-- Same main activity worker; no second Raid worker. Native ownership is confirmed.
function F.raidHostPulse()
    S.RaidPulseAt=os.clock()
    if not S.Run or not S.Ready then return end
    if S.AutoRaidHost and S.ActivityAllowed.Raid~=false and F.raidNativeEnabled() then
        local id
        for key,row in pairs(X.AutoData or {}) do
            if type(row)=="table" and row.Mode=="Raid" and row.Part=="Toggle" and row.Kind=="Toggle" then id=key;break end
        end
        local pd=Lib.PlayerData
        if not id or not pd or type(pd.AutoSettings)~="table" then
            safeDesc(UI.RaidHostStatus,"Waiting for native Raid setting data; no ticket spent.");return
        end
        if pd.AutoSettings[id]==true then
            if not S.RaidNativeOffAttempt then
                S.RaidNativeOffAttempt=os.clock();S.BuiltInAutos[id]=false;save()
                fire("AutoSystem","Toggle",id)
            end
            safeDesc(UI.RaidHostStatus,os.clock()-S.RaidNativeOffAttempt>10
                and "Native Raid OFF not confirmed. Turn it off in game; no ticket spent."
                or "Turning native Auto Raid OFF; waiting for confirmation before hosting.")
            return
        end
        safeDesc(UI.RaidHostStatus,"Native Raid state unavailable; no ticket spent.");return
    end
    if S.AutoRaidHost and not S.RaidHostPending then
        local room=F.raidHostOwnRoom()
        if room then
            -- Existing rooms are adopted before the blocked flag, never recreated.
            local map,diff=room:GetAttribute("MapId"),room:GetAttribute("Diff")
            if type(map)=="string" and type(diff)=="string" then
                local pending={map=map,diff=diff,at=os.clock(),room=room,adopted=true}
                S.RaidHostPending=pending;ENV.ShiroNekoRaidHostPending=pending
            else safeDesc(UI.RaidHostStatus,"Owned room data incomplete; waiting.");return end
        end
    end
    F.raidHostObserve()
    if not S.AutoRaidHost then safeDesc(UI.RaidHostStatus,"OFF: no new Create or Start requests.");return end
    if S.ActivityAllowed.Raid==false then safeDesc(UI.RaidHostStatus,"Paused by Priorities: allow Raid or re-enable Auto Host.");return end
    if not S.RaidHostPending then F.raidHostReady() end
end

