function F.magicKnightQuestRows()
    local quests=Lib.PlayerData and Lib.PlayerData.Quests
    local rows,seen={},{}
    local function add(kind,list)
        if type(list)~="table" then return end
        for id,state in pairs(list) do
            if type(id)=="string" or type(id)=="number" then
                local key=tostring(kind).."\0"..tostring(id)
                if not seen[key] then
                    seen[key]=true
                    rows[#rows+1]={kind=tostring(kind),id=id,state=state}
                end
            end
        end
    end
    if type(quests)=="table" then
        for kind,list in pairs(quests) do
            local text=normalizedText(kind):gsub("[^%w]","")
            if text=="magicknight" or string.find(text,"clover",1,true) or string.find(text,"magic",1,true) then
                add(kind,list)
            end
        end
    end
    table.sort(rows,function(a,b) return (a.kind..":"..tostring(a.id)):lower()<(b.kind..":"..tostring(b.id)):lower() end)
    return rows
end

