-- The existing Results path is valid only while every ancestor is visible.
function F.returnButton()
    local pg=LP:FindFirstChild("PlayerGui")
    local node=pg and pg:FindFirstChild("Results")
    for _,name in ipairs({"Content","Buttons","Return"}) do
        node=node and node:FindFirstChild(name)
    end
    if not node or not node:IsA("GuiButton") then return nil end
    local parent=node
    while parent and parent~=pg do
        if parent:IsA("GuiObject") and not parent.Visible then return nil end
        if parent:IsA("ScreenGui") and not parent.Enabled then return nil end
        parent=parent.Parent
    end
    if parent~=pg then return nil end
    return node
end
function F.returnTick(now)
    if not S.Run or not S.Ready or F.trialUrgent() or not (S.AutoReturn or (S.AutoRaidHost and S.RaidHostReturn and S.RaidResultOwned)
        or (S.AutoTowerHost and S.TowerHostReturn and S.TowerResultOwned)) then
        S.ReturnState=nil
        return
    end
    local button=F.returnButton()
    if not button then
        if not F.inMode("Raid") and not S.RaidHostPending then S.RaidResultOwned=nil end
        if not F.inMode("Tower") and not S.TowerHostPending then S.TowerResultOwned=nil end
        S.ReturnState=nil
        safeDesc(UI.ReturnStatus,"Waiting for the shared Game Result screen.")
        return
    end
    local state=S.ReturnState
    if not state or state.button~=button then
        state={button=button,seen=now,tries=0,last=-math.huge}
        S.ReturnState=state
    end
    local title=button:FindFirstChild("Title")
    local label=title and title:IsA("TextLabel") and title.Text or ""
    -- Displayed countdown is not proof the button is disabled.
    local interactable=true
    pcall(function() interactable=button.Interactable end)
    if not button.Active or not interactable then
        state.ready=nil
        safeDesc(UI.ReturnStatus,"Waiting until Return is available: "..label)
        return
    end
    state.ready=state.ready or now
    if now-state.ready<S.ReturnDelay then
        safeDesc(UI.ReturnStatus,"Return button ready; waiting configured delay ("..S.ReturnDelay.."s).")
        return
    end
    if now-state.last<3 then return end
    if state.tries>=3 then
        safeDesc(UI.ReturnStatus,"Return screen still open after 3 attempts. Press Return manually; retry resets when screen closes.")
        return
    end
    local signalFire=ENV.firesignal or firesignal
    local connections=ENV.getconnections or getconnections
    if type(signalFire)~="function" or type(connections)~="function" then
        safeDesc(UI.ReturnStatus,"Auto Return unavailable: executor needs firesignal and getconnections. Use Return manually.")
        return
    end
    local signal
    for _,candidate in ipairs({button.MouseButton1Click,button.Activated}) do
        local ok,list=pcall(connections,candidate)
        if ok and type(list)=="table" then
            for _,connection in ipairs(list) do
                local readable,enabled=pcall(function() return connection.Enabled end)
                if readable and enabled==true then signal=candidate break end
            end
        end
        if signal then break end
    end
    if not signal then
        safeDesc(UI.ReturnStatus,"Waiting for the Return button handler.")
        return
    end
    state.last=now;state.tries=state.tries+1
    local ok,err=pcall(signalFire,signal)
    safeDesc(UI.ReturnStatus,ok and ("Return button signalled; waiting for screen to close ("..state.tries.."/3).") or ("Return failed: "..tostring(err)))
end

