function F.refreshDeleteRarities()
    local data=gd("RarityData");local values={}
    for id,row in pairs(data) do if type(id)=="string" and type(row)=="table" then values[#values+1]=id end end
    table.sort(values)
    -- v1.4.47: delayed/missing RarityData is unknown, not "no rarities". Keep saved choices.
    if #values==0 then
        safeDesc(UI.DeleteStatus,"Rarity data unavailable; saved rarity choices kept. Nothing is deleted until rarity data loads.")
        return
    end
    for _,def in ipairs(DeleteDefs) do
        local picked={}
        for _,id in ipairs(type(S.DeleteRarities[def.id])=="table" and S.DeleteRarities[def.id] or {}) do
            if table.find(values,id) then picked[#picked+1]=id end
        end
        S.DeleteRarities[def.id]=picked
        UI.DeleteRarityRows[def.id]:Refresh(values);UI.DeleteRarityRows[def.id]:Select(picked)
    end
end

