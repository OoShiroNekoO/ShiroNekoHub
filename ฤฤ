function F.raidTicketTarget()
    local maps=X.GamemodeData and X.GamemodeData.Raid
    local pd=Lib.PlayerData;local svc=X.GamemodeService;local auto=X.AutoService
    if type(maps)~="table" or type(pd)~="table" or type(pd.Items)~="table" or not svc or not auto
        or type(svc.GetSchedule)~="function" or type(auto.GetMaps)~="function" or type(auto.CanEnter)~="function" then
        return nil,"Waiting for Raid ticket/map services."
    end
    local ok,allowed=pcall(auto.GetMaps,"Raid",pd)
    if not ok or type(allowed)~="table" then return nil,"Raid map eligibility unavailable." end
    local candidates={}
    for _,map in ipairs(allowed) do
        local def=maps[map]
        local ticket=type(def)=="table" and (def.OpenItem or def.RequiredItem)
        local required=type(def)=="table" and (def.OpenItem and 1 or tonumber(def.RequiredAmount) or 1)
        if type(map)=="string" and type(def)=="table" and not def.NoAuto and not def.ServerHost
            and type(ticket)=="string" and ticket~=""
            and (S.RaidHostSelection~="Selected Raid map only" or map==S.RaidMap) then
            local count=tonumber(pd.Items[ticket]) or 0
            if count==count and required and required>0 and count>=required and count<math.huge then
                local eligible,diff=pcall(function()
                    local diffs=svc.GetDiffs("Raid",map)
                    if type(diffs)~="table" or #diffs==0 then return nil end
                    local selected=S.RaidHostDifficulty=="Use Raid Difficulty" and S.RaidDiff or diffs[1]
                    if not table.find(diffs,selected) or svc.GetSchedule("Raid",map,selected) then return nil end
                    if auto.CanEnter(pd,"Raid",map,selected)~=true then return nil end
                    if type(svc.CanOpenRoom)=="function" and not svc.CanOpenRoom("Raid",map,LP.UserId) then return nil end
                    return selected
                end)
                if eligible and diff then candidates[#candidates+1]={map=map,diff=diff,ticket=ticket,count=math.floor(count),order=tonumber(def.Order) or 0} end
            end
        end
    end
    table.sort(candidates,function(a,b)
        if a.count~=b.count then return a.count>b.count end
        if a.order~=b.order then return a.order<b.order end
        return a.map<b.map
    end)
    return candidates[1],"No eligible Raid ticket for this difficulty. Check tickets, unlocked maps and Raid Difficulty."
end
