function F.jewelCraftTick(now)
    if not S.Run or not S.Ready then return end
    if S.JewelUnequip then
        local state=S.JewelUnequip;local pd=Lib.PlayerData
        local item=pd and pd.Jewels and pd.Jewels[state.uid]
        if item and not item.Equipped and X.InventoryService:CanConsume(pd,"Jewel",state.uid) then
            S.JewelUnequip=nil;ENV.ShiroNekoJewelUnequip=nil;S.JewelCraftNext=0
            safeDesc(UI.JewelCraftStatus,"Ingredient unequipped; rechecking recipe before craft.")
        elseif now-state.at>=10 then
            S.JewelCraftBlocked=true;ENV.ShiroNekoJewelCraftBlocked=true
            safeDesc(UI.JewelCraftStatus,"Unequip unconfirmed. Paused; check native Equip Best / inventory before reset.")
        end
        return
    end
    local pending=S.JewelCraftPending
    if pending then
        local copies=F.jewelCopies(pending.id,false)
        local added=false;for _,uid in ipairs(copies) do if not pending.before[uid] then added=uid;break end end
        if added then
            if S.JewelRestore then S.JewelRestore.uid=added;S.JewelRestore.ready=true;S.JewelRestore.sent=nil end
            S.JewelCraftPending=nil;ENV.ShiroNekoJewelCraftPending=nil;S.JewelCraftNext=now+2
            safeDesc(UI.JewelCraftStatus,"New Jewel observed: "..pending.id..". Rechecking materials.")
        elseif now-pending.at>=20 then
            S.JewelCraftBlocked=true;ENV.ShiroNekoJewelCraftBlocked=true
            -- Preserve uncertain request across reinjection; reset requires an explicit button.
            safeDesc(UI.JewelCraftStatus,"Craft unconfirmed after 20s. Paused; inspect inventory before resetting.")
        end
        return
    end
    if S.JewelRestore and (S.JewelRestore.ready or not S.AutoJewelCraft) then F.jewelRestoreTick(now);return end
    if not S.AutoJewelCraft then return end
    if S.JewelCraftBlocked or ENV.ShiroNekoJewelCraftBlocked then safeDesc(UI.JewelCraftStatus,"Paused: inspect inventory, then Reset craft confirmation.");return end
    if now<(S.JewelCraftNext or 0) then return end
    S.JewelCraftNext=now+3
    local row,reason,complete=F.jewelCraftPlan();S.JewelCraftComplete=complete
    safeDesc(UI.JewelCraftStatus,reason)
    if not row then if S.JewelRestore then F.jewelRestoreTick(now) end;return end
    if F.trialUrgent() or LP:GetAttribute("Teleporting")==true or S.ItemBusy then return end
    if row.unequip then
        local item=Lib.PlayerData.Jewels[row.unequip]
        if not item or not item.Equipped then return end
        local state={uid=row.unequip,at=now}
        S.JewelRestore={uid=row.unequip};ENV.ShiroNekoJewelRestore=S.JewelRestore
        S.JewelUnequip=state;ENV.ShiroNekoJewelUnequip=state
        fire("InventorySystem","Equip","Jewel",row.unequip) -- native Equip is the proven toggle
        safeDesc(UI.JewelCraftStatus,"Unequipping existing ingredient; waiting before craft.")
        return
    end
    -- Single-flight request. Exact recipe/data and current consumable copies checked above.
    local before={};for _,uid in ipairs(F.jewelCopies(row.id,false)) do before[uid]=true end
    local state={id=row.id,typ=row.typ,at=now,before=before}
    S.JewelCraftPending=state;ENV.ShiroNekoJewelCraftPending=state
    local sent=fire("ExchangeSystem","Make","Crafting",row.typ,row.id,1)
    if not sent then S.JewelCraftBlocked=true;ENV.ShiroNekoJewelCraftBlocked=true end
    safeDesc(UI.JewelCraftStatus,sent and ("Craft requested: "..row.id..". Waiting for new inventory item.") or "Craft submission unconfirmed. No automatic retry.")
end

function F.secretOwned(kind,id)
