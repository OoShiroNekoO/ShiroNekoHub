function F.secretCatalog()
    if S.SecretCatalog then return S.SecretCatalog end
    local out={}
    assert(type(X.AvatarData)=="table" and next(X.AvatarData) and type(X.AccessoryData)=="table" and next(X.AccessoryData),"Waiting for Secret item definitions")
    for id,enemy in pairs(X.EnemyData or {}) do
        if type(enemy)=="table" and enemy.Type=="Normal" and X.MapData[enemy.Map] and type(enemy.Drops)=="table" then
            local objectives,seen={},{}
            local function add(kind,key)
                local identity=kind..":"..key
                if not seen[identity] then seen[identity]=true;objectives[#objectives+1]={kind=kind,id=key} end
            end
            for _,drop in ipairs(enemy.Drops) do
                if type(drop)=="table" and type(drop.Id)=="string" and (drop.Chance==nil or tonumber(drop.Chance) and tonumber(drop.Chance)>0) then
                    if drop.Type=="Avatar" and X.AvatarData[drop.Id] and X.AvatarData[drop.Id].Rarity=="Secret" then add("Avatar",drop.Id) end
                    if drop.Type=="Accessory" then
                        local direct=X.AccessoryData[drop.Id]
                        if direct and direct.Rarity=="Secret" then add("Accessory",drop.Id) end
                        local order=tonumber(drop.Id:match("^RandomAccessory(%d+)$"))
                        if order then
                            for aid,def in pairs(X.AccessoryData) do
                                local map=X.MapData[def.Map]
                                if def.Rarity=="Secret" and map and map.Order==order then add("Accessory",aid) end
                            end
                        end
                    end
                end
            end
            if #objectives>0 then out[#out+1]={id=id,map=enemy.Map,name=enemy.Name or id,objectives=objectives,order=X.MapData[enemy.Map].Order or 0} end
        end
    end
    table.sort(out,function(a,b)if a.order~=b.order then return a.order<b.order end;return a.id<b.id end)
    S.SecretCatalog=out;return out
end
function F.refreshSecretTargets()
    if not UI.SecretTargets then return end
