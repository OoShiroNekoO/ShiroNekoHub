                    if S.OrigPrompt[p]==nil then S.OrigPrompt[p]=p.HoldDuration end
                    pcall(function() p.HoldDuration=0 end)
                end
            end
        end
        if S.AutoSpawn and type(fireproximityprompt)=="function" then
            for _,i in ipairs(CS:GetTagged("SpawnItem")) do
                if not (S.AutoCommandment and i:GetAttribute("Type")=="CommandmentFragment") then
                    local p=i:FindFirstChildWhichIsA("ProximityPrompt",true)
                    local r=root(); local pos=F.itemPos(i)
                    if S.Run and p and p.Enabled and r and pos and (r.Position-pos).Magnitude<=p.MaxActivationDistance then pcall(fireproximityprompt,p) end
                end
            end
        end
        task.wait(2)
    end
end)

