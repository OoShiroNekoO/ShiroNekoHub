function F.trialOpenTarget()
    local diffs=F.trialDiffs()
    local preferred=S.TimeTrialDiff
    local function check(diff)
        local w=F.trialWindow(diff)
        return w and w.Open==true and diff or nil,w
    end
    local selected,w=check(preferred)
    if selected then return selected,w end
    -- GetDiffs follows the game's difficulty order; reverse it so a newly
    -- available higher tier such as T3 is preferred over an older tier.
    for i=#diffs,1,-1 do
        local diff=diffs[i]
        if diff~=preferred then
            selected,w=check(diff)
            if selected then return selected,w end
        end
    end
