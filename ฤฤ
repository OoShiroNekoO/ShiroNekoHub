-- Patch 1.4.43: explicit native toggle controls; Select/Priority contracts are not inferred.
function F.refreshPatchAutos()
    local previous=S.UIHydrating
    S.UIHydrating=true
    local states=Lib.PlayerData and Lib.PlayerData.AutoSettings
    local ready,blocked=0,0
    for id,control in pairs(UI.PatchAutoRows or {}) do
        local def=X.AutoData and X.AutoData[id]
        local supported=type(def)=="table" and def.Kind=="Toggle" and type(states)=="table"
        local pending=S.NativeAutoPending and S.NativeAutoPending[id]
        if pending and type(states)=="table" and states[id]==pending.want then
            S.NativeAutoPending[id]=nil;pending=nil
        end
        local ok,err=pcall(function()
            control:Set(supported and states[id]==true or false)
            if supported and not pending then control:Unlock() else control:Lock() end
            control:SetDesc(pending and "Waiting for game confirmation; no repeated toggle is sent. Refresh after the state arrives."
                or (supported and "Native toggle detected. Unlock requirements still apply in game."
                or "Waiting for AutoSettings, or native toggle is unavailable."))
        end)
        if not ok then S.LastError=tostring(err) end
        if supported then ready=ready+1 else blocked=blocked+1 end
    end
    S.UIHydrating=previous
    safeDesc(UI.PatchAutoStatus,string.format("Detected toggle controls: %d | unavailable/loading: %d. Metadata checks only; gameplay is not live-verified. Priority/Select values must be set in the game's Auto menu.",ready,blocked))
end

