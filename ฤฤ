-- Completely restored to v1.4.21 without the trial combat throttle.
function F.inventoryEquipTick(now)
    if not S.Run or not S.Ready then return end
    S.LastInventoryEquipBySlot=S.LastInventoryEquipBySlot or {}
    local sent={}
    for _,slot in ipairs(InventoryEquipSlots) do
        local id=S.InventoryEquipBindings[slot]
        local last=S.LastInventoryEquipBySlot[slot] or -math.huge
        if S.InventoryEquipEnabled[slot] and (slot~="Jewels" or id=="Jewel") and type(id)=="string" and id~=""
            and now-last>=S.InventoryEquipIntervals[slot] then
            -- Hero owns Pet requests while its own automation is enabled.
            if id=="Jewel" and F.jewelEquipHeld() then
                safeDesc(UI.InventoryEquipRows[slot],"Equip Best waits for the active craft / restore transaction.")
            elseif id=="Pet" and S.AutoHero then
                S.LastInventoryEquipBySlot[slot]=now
            elseif sent[id] or fire("InventorySystem","EquipBest",id) then
                sent[id]=true
                S.LastInventoryEquipBySlot[slot]=now
            end
        end
    end
end
