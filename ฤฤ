-- v1.4.47: SettingSystem Toggle flips state. Missing Settings means unknown (not OFF),
-- and a second Toggle before replication could switch it back, so keep one pending
-- request per setting until the replicated value matches. No automatic repeat.
local function setGameSetting(id,want)
    local settings=Lib.PlayerData and Lib.PlayerData.Settings
    if type(settings)~="table" then return false end
    local current=settings[id]==true
    S.SettingPending=S.SettingPending or {}
    local pending=S.SettingPending[id]
    if pending then
        if current==pending.want or pending.want~=want then
            S.SettingPending[id]=nil
        else
            if not pending.reported and os.clock()-pending.at>=10 then
                pending.reported=true
                S.LastError=tostring(id).." toggle not confirmed after 10s; no repeat sent. Turn Use Auto Click OFF/ON (Farming) to retry."
            end
            return false
        end
    end
    if current==want then return true end
    local sent=fire("SettingSystem","Toggle",id)
    if sent then S.SettingPending[id]={want=want,at=os.clock()} end
    return sent
end
local function allAuto(parent,want)
    if not parent then return end
    if not S.Ready or not S.Run then return end
    for id,d in pairs(X.AutoData or {}) do
        if not S.Run then break end
        if type(d)=="table" and d.Kind=="Toggle" and d.Parent==parent then
            toggleNativeAuto(id,want)
            task.wait(.04)
        end
    end
    save()
end
local function findAutoParent(words)
    local found={}
    for _,d in pairs(X.AutoData or {}) do
        if type(d)=="table" and type(d.Parent)=="string" then found[d.Parent]=true end
    end
    for p in pairs(found) do
        local l=p:lower()
        for _,w in ipairs(words) do
            if l:find(w,1,true) then return p end
        end
    end
end

