function F.diagnosticSnapshot()
    local seen,budget={},8000
    local function plain(value,depth)
        local kind=type(value)
        if kind=="string" or kind=="boolean" then return value end
        if kind=="number" then return value==value and math.abs(value)<math.huge and value or tostring(value) end
        if kind~="table" then return "<"..kind..">" end
        if depth>8 or seen[value] or budget<=0 then return "<cut>" end
        seen[value]=true
        local out={}
        for key,v in pairs(value) do
            budget=budget-1;if budget<=0 then out._cut=true;break end
            if type(key)=="string" or type(key)=="number" then out[tostring(key)]=plain(v,depth+1) end
        end
        seen[value]=nil
        return out
    end
    local pd=Lib.PlayerData or {}
