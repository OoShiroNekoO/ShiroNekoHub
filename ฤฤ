function F.secretSelected(item)
    return S.SecretSelection~="Selected" or table.find(S.SecretTargets,item.kind..":"..item.id)~=nil
end
function F.secretPlan()
    local pd=Lib.PlayerData
    assert(pd and type(pd.UnlockedMap)=="table","Waiting for unlocked maps")
    local catalog=F.secretCatalog();local available,missing,locked,seen={},0,0,{}
    for _,row in ipairs(catalog) do
        local need={}
        for _,item in ipairs(row.objectives) do
            if (item.kind=="Avatar" and S.SecretAvatar or item.kind=="Accessory" and S.SecretAccessory) and F.secretSelected(item) and not F.secretOwned(item.kind,item.id) then
                need[#need+1]=item
            end
        end
        if #need>0 then
            if pd.UnlockedMap[row.map]==true or X.MapData[row.map].AlwaysUnlocked==true then
                available[#available+1]={row=row,need=need}
                for _,item in ipairs(need) do local key=item.kind..":"..item.id;if not seen[key] then seen[key]=true;missing=missing+1 end end
            else locked=locked+1 end
        end
    end
    if not S.SecretAvatar and not S.SecretAccessory then return nil,"Choose Avatar and/or Accessory.",0 end
    if S.SecretSelection=="Selected" and #S.SecretTargets==0 then return nil,"Select Secret items first; no targets selected.",0 end
    if #catalog==0 then return nil,"No verified Secret boss drop sources found.",0 end
    for _,entry in ipairs(available) do if entry.row.id==S.SecretBossId then return entry,"Missing "..missing.." Secret items",missing end end
    local chosen=available[1]
    if chosen then return chosen,"Missing "..missing.." Secret items",missing end
    return nil,"All selected Secrets in unlocked maps owned. Locked boss sources: "..locked,0
end
function F.secretStep()
    if not S.Run or not S.Ready or not S.AutoSecret or F.farmMovementBlocked() or S.ItemBusy then return end
    local now=os.clock()
    if now<(S.SecretNextCheck or 0) then return end
    S.SecretNextCheck=now+1
    local entry,status=F.secretPlan()
    if not entry then S.SecretBossId=nil;safeDesc(UI.SecretStatus,status);return end
    local row=entry.row;S.SecretBossId=row.id
    local need={};for _,x in ipairs(entry.need) do need[#need+1]=x.kind..": "..x.id end
    local prefix=row.name.." | "..table.concat(need,", ")
    local pd=Lib.PlayerData
    if pd.CurrentMap~=row.map then
        local pending=S.SecretTeleport
        if pending and pending.map==row.map then
            safeDesc(UI.SecretStatus,prefix..(now-pending.at>=20 and " | Map entry unconfirmed. Toggle Secret OFF/ON to retry." or " | Waiting for map entry."));return
        end
        S.SecretTeleport={map=row.map,at=now}
        fire("TeleportSystem","To",row.map)
        safeDesc(UI.SecretStatus,prefix.." | Travelling to "..row.map);return
    end
    S.SecretTeleport=nil
    local _,server=F.enemyFolders();local world=server and server:FindFirstChild(row.map)
    local r,h=root(),hum();if not world or not r or not h or h.Health<=0 then safeDesc(UI.SecretStatus,prefix.." | Waiting for world/character.");return end
    local best,distance
    for _,marker in ipairs(world:GetDescendants()) do
        if marker:IsA("BasePart") and marker:GetAttribute("Id")==row.id and marker:GetAttribute("Map")==row.map and not F.dead(marker) then
            local d=(marker.Position-r.Position).Magnitude
            if not distance or d<distance then best=marker;distance=d end
        end
    end
    if not best then safeDesc(UI.SecretStatus,prefix.." | Waiting for this boss to respawn.");return end
    -- Always position at the chosen boss; Group Center must not pull toward unrelated mobs.
    local p=(best.CFrame*CFrame.new(0,S.FarmHeight,S.FarmDistance)).Position
    if F.farmMovementBlocked() or not S.AutoSecret then return end
    if S.FarmAutoClick then setGameSetting("AutoClick",true) end
    if (r.Position-p).Magnitude>S.FarmDrift then
        local look=Vector3.new(best.Position.X,p.Y,best.Position.Z)
        if (look-p).Magnitude<.01 then look=p+r.CFrame.LookVector end
        r.CFrame=CFrame.lookAt(p,look)
        pcall(function() r.AssemblyLinearVelocity=Vector3.zero;r.AssemblyAngularVelocity=Vector3.zero end)
    end
    safeDesc(UI.SecretStatus,prefix.." | Farming until the listed items are owned.")
end

