function F.modelRoot(m)
    if m and m:IsA("BasePart") then return m end
    return m and m:IsA("Model") and (m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("RootPart") or m.PrimaryPart or m:FindFirstChild("EnemyHitbox",true))
end
function F.serverRoot(m)
    local _,sv=F.enemyFolders()
    if m and sv and m:IsA("BasePart") and m:IsDescendantOf(sv) then return m end
    return m and sv and sv:FindFirstChild(m.Name,true)
end
function F.enemyId(m)
    local r=F.serverRoot(m)
    return r and r:GetAttribute("Id")
end
function F.dead(m)
    if not m or not m.Parent or not m:IsDescendantOf(workspace) then return true end
    local _,sv,cl,ir=F.enemyFolders()
    local marker=sv and m:IsA("BasePart") and m:IsDescendantOf(sv)
    local rendered=(cl and m:IsDescendantOf(cl)) or (ir and m:IsDescendantOf(ir))
    if not marker and not rendered then return true end
    local r=F.serverRoot(m)
    return not r or not r:IsA("BasePart") or r:GetAttribute("Dead")~=false or type(r:GetAttribute("HP"))~="number" or r:GetAttribute("HP")<=0
end
function F.scan()
    if os.clock()-S.LastScan<.5 then return S.EnemyCache end
    local scanAt=os.clock()
    local _,_,cl,ir=F.enemyFolders()
    local out,seen={},{}
    for _,folder in pairs({Client=cl,InRange=ir}) do
        if folder then for _,m in ipairs(folder:GetChildren()) do
            if m:IsA("Model") and not seen[m] and F.modelRoot(m) and F.serverRoot(m) and not F.dead(m) then seen[m]=true out[#out+1]=m end
        end end
    end
    S.LastScan=scanAt;S.EnemyCache=out return out
end
-- Include replicated position markers even before nearby visual models exist.
-- Trial keeps its own scan/selection behavior; only farming/group positioning use this list.
function F.farmScan()
    local now=os.clock()
    if S.FarmScanAt and now-S.FarmScanAt<.5 then return S.FarmEnemyCache or {} end
    local out,seen={},{}
    for _,m in ipairs(F.scan()) do
        local marker=F.serverRoot(m)
        if marker and not seen[marker] and not F.dead(m) then
            seen[marker]=true;out[#out+1]=m
        end
    end
    local _,server=F.enemyFolders()
    if server then
        for _,marker in ipairs(server:GetDescendants()) do
            if marker:IsA("BasePart") and marker:GetAttribute("Id")~=nil
                and not seen[marker] and not F.dead(marker) then
                seen[marker]=true;out[#out+1]=marker
            end
        end
    end
    S.FarmScanAt=now;S.FarmEnemyCache=out
    return out
end
function F.targetSelected(id)
    for _,x in ipairs(S.FarmTargets) do if tostring(x)=="*" or tostring(x)==tostring(id) then return true end end
    return false
end
function F.pickTarget()
    local r=root() if not r then return nil end
    local best,score
    for _,m in ipairs(F.farmScan()) do
        if not F.dead(m) and F.targetSelected(F.enemyId(m)) then
            local mr=F.modelRoot(m)
            local sr=F.serverRoot(m)
            local dist=(mr.Position-r.Position).Magnitude
            local hp=tonumber(sr:GetAttribute("HP")) or math.huge
            local mx=tonumber(sr:GetAttribute("MaxHP")) or hp
            local d=(X.EnemyData or {})[F.enemyId(m)]
            local boss=d and (d.Type=="Boss" or d.Boss==true)
            local s=dist
            if S.FarmPriority=="Boss First" then s=(boss and 0 or 1e6)+dist
            elseif S.FarmPriority=="Lowest HP" then s=hp+dist*.001
            elseif S.FarmPriority=="Highest HP" then s=-mx+dist*.001 end
            if not score or s<score then best,score=m,s end
        end
    end
    return best
end
-- v1.4.51 Group Center: cover as many selected targets as possible with the game's real attack
-- zone and stay put while the current spot already covers them (no warp every second).
-- Returns a Vector3 to warp to, "stay", or nil (fallback to the single-target position).
function F.groupDestination(m,r,mr)
    local now=os.clock()
    if S.GroupPlanAt and now-S.GroupPlanAt<.5 and S.GroupAnchor==m then return "stay" end
    S.GroupPlanAt=now;S.GroupAnchor=m
    local radius,source=F.attackRadius()
    local anchorPos=mr.Position
    local sr=F.serverRoot(m)
    local map=sr and sr:GetAttribute("Map")
    local pts,seen,anchorPt={}, {},nil
    for _,enemy in ipairs(F.farmScan()) do
        if not F.dead(enemy) and F.targetSelected(F.enemyId(enemy)) then
            local marker=F.serverRoot(enemy);local er=F.modelRoot(enemy)
            if marker and er and not seen[marker] and (not map or marker:GetAttribute("Map")==map) then
                local p=er.Position
                local d=(p.X-anchorPos.X)^2+(p.Z-anchorPos.Z)^2
                if math.abs(p.Y-anchorPos.Y)<=12 and d<=(3*radius)^2 then
                    seen[marker]=true
                    local pt={x=p.X,z=p.Z,y=p.Y,d=d}
                    if enemy==m then anchorPt=pt end
                    pts[#pts+1]=pt
                end
            end
        end
    end
    if not anchorPt then anchorPt={x=anchorPos.X,z=anchorPos.Z,y=anchorPos.Y,d=0};pts[#pts+1]=anchorPt end
    table.sort(pts,function(a,b) return a.d<b.d end)
    while #pts>30 do table.remove(pts) end
    local best,info=F.groupMove(pts,anchorPt,r.Position,radius)
    local summary=info and string.format("In range here: %d / %d | best spot: %d | attack radius %.0f studs (%s)",info.here,info.total,info.best,radius,source) or ""
    if not best then
        safeDesc(UI.GroupStatus,(info and info.waiting) and (summary.." | waiting before next warp") or (summary.." | staying"))
        return "stay"
    end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local enemies=F.enemyFolders()
    local exclude={}
    if enemies then exclude[#exclude+1]=enemies end
    if LP.Character then exclude[#exclude+1]=LP.Character end
    params.FilterDescendantsInstances=exclude
    params.RespectCanCollide=true
    local hit=workspace:Raycast(Vector3.new(best.x,anchorPos.Y+12,best.z),Vector3.new(0,-32,0),params)
    if not hit or hit.Normal.Y<.6 or math.abs(hit.Position.Y-anchorPos.Y)>12 then
        safeDesc(UI.GroupStatus,summary.." | no floor at that spot; using target position.")
        return nil
    end
    local h=hum()
    local clearance=(h and h.HipHeight or 2)+r.Size.Y/2
    safeDesc(UI.GroupStatus,summary.." | moving to cover "..info.best)
    return Vector3.new(best.x,hit.Position.Y+clearance+S.FarmHeight,best.z)
end

function F.stopTrialWalk()
    S.TrialRoute=nil
    local h=S.WalkHumanoid
    S.WalkHumanoid=nil;S.WalkGoal=nil;S.WalkProgressPos=nil;S.WalkProgressAt=nil
    if h and h.Parent then pcall(function() h:Move(Vector3.zero,false) end) end
end
-- Retained movement behavior with regression repairs.
function F.walkTrialTarget(m,center)
    local r,h=root(),hum()
    local mr=F.modelRoot(m)
    local goal=center or (mr and mr.Position)
    if not r or not goal or not h or h.Health<=0 then F.stopTrialWalk();return false end
    if S.Fly then F.stopTrialWalk();safeDesc(UI.TrialWalkStatus,"Turn Fly OFF to walk in Trial.");return false end
    
    local dx,dz=goal.X-r.Position.X,goal.Z-r.Position.Z
    if dx*dx+dz*dz<=S.TrialDistance*S.TrialDistance and math.abs(goal.Y-r.Position.Y)<8 then
        F.stopTrialWalk()
        safeDesc(UI.TrialWalkStatus,"Within Trial stop distance; attacking selected enemy.")
        return true
    end
    
    local now=os.clock()
    local route=S.TrialRoute
    if not route or route.h~=h or (route.goal-goal).Magnitude>6 then
        F.stopTrialWalk()
        route={h=h,goal=goal,nextCompute=0};S.TrialRoute=route
    end
    S.WalkHumanoid=h
    -- Start moving without waiting for ComputeAsync, only with a clear corridor
    -- and supporting floor immediately ahead. Cache these raycasts, not Move().
    if not route.clearAt or now-route.clearAt>=.12 then
        route.clearAt=now
        local direction=Vector3.new(dx,0,dz)
        local length=direction.Magnitude
        local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude
        local exclude={LP.Character};local enemies=F.enemyFolders()
        if enemies then exclude[#exclude+1]=enemies end
        params.FilterDescendantsInstances=exclude;params.RespectCanCollide=true
        local clear=length>.01 and math.abs(goal.Y-r.Position.Y)<8
        if clear then
            local unit=direction/length
            local side=Vector3.new(-unit.Z,0,unit.X)*1.5
            for _,offset in ipairs({Vector3.zero,side,side*-1}) do
                if workspace:Raycast(r.Position+offset,direction,params) then clear=false;break end
            end
            if clear then
                local floor=workspace:Raycast(r.Position+unit*math.min(4,length),Vector3.new(0,-8,0),params)
                clear=floor~=nil and floor.Normal.Y>.5
            end
        end
        route.direct=clear
    end
    if route.direct then
        route.points=nil
        h:Move(Vector3.new(dx,0,dz).Unit,false)
        if not route.commandAt or now-route.commandAt>=1 then
            route.commandAt=now;safeDesc(UI.TrialWalkStatus,"Walking continuously to the living Trial target.")
        end
        return true
    end
    if route.points and route.progressAt and now-route.progressAt>=1 then
        if (r.Position-route.progressPos).Magnitude<1 then
            route.points=nil;route.nextCompute=now;h:Move(Vector3.zero,false)
        end
        route.progressAt=now;route.progressPos=r.Position
    end
    if not route.points then
        if route.computing or S.TrialPathComputing or now<route.nextCompute then return false end
        route.computing=true;S.TrialPathComputing=true
        safeDesc(UI.TrialWalkStatus,"Finding a walking route to the Trial target.")
        task.spawn(function()
            local ok,points=pcall(function()
                local path=game:GetService("PathfindingService"):CreatePath({AgentRadius=2,AgentHeight=5,AgentCanJump=true,WaypointSpacing=4})
                path:ComputeAsync(r.Position,goal)
                if path.Status~=Enum.PathStatus.Success then return nil end
                return path:GetWaypoints()
            end)
            S.TrialPathComputing=false;route.computing=false
            if S.TrialRoute~=route or not S.Run or not S.TrialWalk or root()~=r or not F.inMode("Time Trial") then return end
            route.nextCompute=os.clock()+.5
            if ok and type(points)=="table" and #points>0 then
                route.points=points;route.index=1;route.jumpIndex=nil;route.commandAt=nil;route.progressAt=os.clock();route.progressPos=r.Position
            else
                safeDesc(UI.TrialWalkStatus,"Route blocked; checking again in 0.5 seconds.")
            end
        end)
        return false
    end
    local wp=route.points[route.index]
    while wp do
        local x,z=wp.Position.X-r.Position.X,wp.Position.Z-r.Position.Z
        if x*x+z*z>4 or math.abs(wp.Position.Y-r.Position.Y)>7 then break end
        route.index=route.index+1;wp=route.points[route.index];route.commandAt=nil
    end
    if not wp then
        h:Move(Vector3.zero,false)
        route.points=nil;route.nextCompute=now;return false
    end
    if not route.commandAt or now-route.commandAt>=1 then
        route.commandAt=now
        safeDesc(UI.TrialWalkStatus,"Walking to Trial target: waypoint "..route.index.."/"..#route.points)
    end
    if wp.Action==Enum.PathWaypointAction.Jump and route.jumpIndex~=route.index then
        route.jumpIndex=route.index;h.Jump=true
    end
    local direction=Vector3.new(wp.Position.X-r.Position.X,0,wp.Position.Z-r.Position.Z)
    h:Move(direction.Magnitude>0.001 and direction/direction.Magnitude or Vector3.zero,false)
    return true
end
-- Room pattern: one center enemy and two opposite pairs of surrounding enemies.
function F.findTrialRoom(rows,origin)
    local best,bestScore
    for _,center in ipairs(rows) do
        local neighbors={}
        for _,row in ipairs(rows) do
            local dx,dz=row.p.X-center.p.X,row.p.Z-center.p.Z
            local length=math.sqrt(dx*dx+dz*dz)
            if row~=center and row.map==center.map and math.abs(row.p.Y-center.p.Y)<=8
                and length>=6 and length<=120 then
                neighbors[#neighbors+1]={row=row,x=dx,z=dz,length=length}
            end
        end
        table.sort(neighbors,function(x,y)return x.length<y.length end)
        while #neighbors>12 do table.remove(neighbors) end
        local pairsFound={}
        for i=1,#neighbors do for j=i+1,#neighbors do
            local x,y=neighbors[i],neighbors[j]
            local error=math.sqrt((x.x+y.x)^2+(x.z+y.z)^2)/(x.length+y.length)
            if error<=.16 then pairsFound[#pairsFound+1]={a=x,b=y,error=error} end
        end end
        for i=1,#pairsFound do for j=i+1,#pairsFound do
            local x,y=pairsFound[i],pairsFound[j]
            if x.a~=y.a and x.a~=y.b and x.b~=y.a and x.b~=y.b then
                local dot=math.abs(x.a.x*y.a.x+x.a.z*y.a.z)/(x.a.length*y.a.length)
                local radius=math.max(x.a.length,x.b.length,y.a.length,y.b.length)
                local smallest=math.min(x.a.length,x.b.length,y.a.length,y.b.length)
                if dot<.85 and radius/smallest<1.8 then
                    local score=(center.p-origin).Magnitude+(x.error+y.error)*20
                    if not bestScore or score<bestScore then
                        bestScore=score
                        best={center=center,members={center,x.a.row,x.b.row,y.a.row,y.b.row}}
                    end
                end
            end
        end end
    end
    return best
end
-- Keep room identity separate from the current walking target.
function F.resetTrialRoom()
    S.TrialCenter=nil;S.TrialCenterMarker=nil;S.TrialCenterName=nil;S.TrialCenterMap=nil
    S.TrialRoomMembers=nil;S.TrialTarget=nil;S.TrialRoomScanAt=nil
end
function F.trialRoomGoal()
    if not S.TrialRoomMembers then return nil end
    local r=root()
    if not r then return nil end
    local nearest,nearestDistance,remaining=nil,math.huge,0
    for _,marker in ipairs(S.TrialRoomMembers) do
        if F.trialEnemyEligible(marker) then
            remaining=remaining+1
            local distance=(marker.Position-r.Position).Magnitude
            if distance<nearestDistance then nearest,nearestDistance=marker,distance end
        end
    end
    if remaining==0 then return nil end
    local center=S.TrialCenterMarker
    local target=(center and F.trialEnemyEligible(center)) and center or nearest
    if not target then return nil end
    -- Replan on target changes even when two targets are under six studs apart.
    if S.TrialTarget~=target then F.stopTrialWalk();S.TrialTarget=target end
    local name=tostring(target:GetAttribute("Name") or target:GetAttribute("Id") or target.Name)
    safeDesc(UI.TrialCenterStatus,(target==center and "Center: " or "Nearest remaining enemy: ")
        ..name.." | room members remaining: "..remaining)
    return target.Position
end
function F.trialCenterGoal()
    local r=root()
    if not r then return nil end
    -- Check captured markers directly so a dead center is not kept by scan caches.
    local goal=F.trialRoomGoal()
    if goal then return goal end
    if S.TrialRoomMembers then F.stopTrialWalk();F.resetTrialRoom() end
    local now=os.clock()
    if S.TrialRoomScanAt and now-S.TrialRoomScanAt<.1 then return nil end
    S.TrialRoomScanAt=now
    local rows={}
    local _,server=F.enemyFolders()
    for _,m in ipairs(server and server:GetDescendants() or {}) do
        if m:IsA("BasePart") and F.trialEnemyEligible(m) then
            local marker=F.serverRoot(m)
            rows[#rows+1]={p=F.modelRoot(m).Position,map=marker:GetAttribute("Map"),marker=marker,
                name=tostring(marker:GetAttribute("Name") or F.enemyId(m))}
        end
    end
    table.sort(rows,function(x,y)return (x.p-r.Position).Magnitude<(y.p-r.Position).Magnitude end)
    while #rows>80 do table.remove(rows) end
    local room=F.findTrialRoom(rows,r.Position)
    if #rows==0 then
        safeDesc(UI.TrialCenterStatus,"Waiting for living Trial enemies to replicate.");return nil
    end
    -- Do not walk past a closer leftover to chase the next intact room.
    local nearest=rows[1];local belongs=false
    if room then for _,row in ipairs(room.members) do if row.marker==nearest.marker then belongs=true;break end end end
    if not room or (not belongs and (nearest.p-r.Position).Magnitude<(room.center.p-r.Position).Magnitude) then
        S.TrialCenter=nil;S.TrialCenterMarker=nil;S.TrialCenterName=nil;S.TrialCenterMap=nearest.map
        S.TrialRoomMembers={nearest.marker}
        return F.trialRoomGoal()
    end
    S.TrialCenter=room.center.p;S.TrialCenterMarker=room.center.marker
    S.TrialCenterName=room.center.name;S.TrialCenterMap=room.center.map
    S.TrialRoomMembers={}
    for _,row in ipairs(room.members) do S.TrialRoomMembers[#S.TrialRoomMembers+1]=row.marker end
    return F.trialRoomGoal()
end
function F.trialEnemyEligible(m)
    local r=root()
    local mr=F.modelRoot(m)
    if not r or not mr or F.dead(m) then return false end
    -- If the replicated room exists, never include another player's room/world mobs.
    local _,server=F.enemyFolders()
    local modes=server and server:FindFirstChild("Gamemode")
    local id=LP:GetAttribute("InMode")
    local room=modes and type(id)=="string" and id~="" and modes:FindFirstChild(id)
    local marker=F.serverRoot(m)
    if room and (not marker or not marker:IsDescendantOf(room)) then return false end
    -- Retain the existing nearby-arena fallback when no room folder is available.
    return (mr.Position-r.Position).Magnitude<=500 and math.abs(mr.Position.Y-r.Position.Y)<=80
end
function F.trialCombatStep()
    if not S.Run or not S.Ready or not S.TrialWalk or not F.inMode("Time Trial") then
        F.resetTrialRoom();F.stopTrialWalk();return
    end
    if S.ItemBusy or LP:GetAttribute("Teleporting")==true then
        F.stopTrialWalk();return
    end
    if F.returnButton() then
        F.resetTrialRoom();F.stopTrialWalk()
        safeDesc(UI.TrialWalkStatus,"Round finished; waiting for Return.")
        return
    end
    local r=root()
    if not r or not hum() or hum().Health<=0 then
        F.resetTrialRoom();F.stopTrialWalk()
        safeDesc(UI.TrialWalkStatus,"Waiting for character to spawn.")
        return
    end
    local center=F.trialCenterGoal()
    if not center then
        F.stopTrialWalk()
        safeDesc(UI.TrialWalkStatus,"Waiting for living Trial enemies or character data.")
        return
    end
    setGameSetting("AutoClick",true)
    F.walkTrialTarget(nil,center)
end
function F.moveFarmTarget(m)
    if S.TrialWalk and F.inMode("Time Trial") then return F.walkTrialTarget(m) end
    F.stopTrialWalk()
    return F.warpTarget(m)
end

-- Retained movement behavior with regression repairs.
function F.warpTarget(m)
    if F.farmMovementBlocked() then return false end
    local r,mr=root(),F.modelRoot(m) if not r or not mr then return false end
    if os.clock()-S.LastWarp<.5 then return false end
    local p
    if S.FarmMode=="Group Center" then
        p=F.groupDestination(m,r,mr)
        if p=="stay" then return true end
    end
    local group=p~=nil
    p=p or (mr.CFrame*CFrame.new(0,S.FarmHeight,S.FarmDistance)).Position
    if not group and (r.Position-p).Magnitude<=S.FarmDrift then return true end
    local look=Vector3.new(mr.Position.X,p.Y,mr.Position.Z)
    if (look-p).Magnitude<.01 then look=p+r.CFrame.LookVector end
    S.LastWarp=os.clock()
    if group then S.LastGroupWarp=S.LastWarp end
    r.CFrame=CFrame.lookAt(p,look)
    pcall(function() r.AssemblyLinearVelocity=Vector3.zero r.AssemblyAngularVelocity=Vector3.zero end)
    return true
end

function F.portalFolder()
    local rep=(Lib.Replicated and Lib.Replicated:FindFirstChild("Server")) or RS:FindFirstChild("Server")
    return rep and rep:FindFirstChild("Gamemode")
end
function F.inMode(name)
    if LP:GetAttribute("Mode")==name then return true end
    local id=LP:GetAttribute("InMode")
    local folder=F.portalFolder()
    if not folder or id==nil or id==false or id=="" then return false end
    if type(id)~="string" and type(id)~="number" then return false end
    local room=folder:FindFirstChild(tostring(id))
    return room~=nil and room:GetAttribute("ModeId")==name
end
-- One input attempt per Trial entry/character, retained across hub re-execution.
function F.trialMountStep()
    if not S.Run or not S.Ready then return end
    if not F.inMode("Time Trial") then ENV.ShiroNekoTrialMountAttempt=nil;return end
    if not S.TrialMount or LP:GetAttribute("Teleporting") or F.returnButton() then return end
    local character=LP.Character
    local h=hum()
    if not character or not root() or not h or h.Health<=0 then return end
    local session=tostring(LP:GetAttribute("InMode") or "Time Trial")
    local state=ENV.ShiroNekoTrialMountAttempt
    if not state or state.character~=character or state.session~=session then
        state={character=character,session=session,readyAt=os.clock()+2}
        ENV.ShiroNekoTrialMountAttempt=state
    end
    if state.done or os.clock()<state.readyAt then return end
    if UIS:GetFocusedTextBox() then
        safeDesc(UI.TrialMountStatus,"Waiting for text input to close before pressing M.");return
    end
    -- Dump contains this visual folder/name convention; attributes such as MountVisual
    -- alone may represent equipment selections and are not proof of being mounted.
    local ignore=workspace:FindFirstChild("_IGNORE")
    local mounts=ignore and ignore:FindFirstChild("Mounts")
    if mounts and mounts:FindFirstChild("Mount"..tostring(LP.UserId)) then
        state.done=true
        safeDesc(UI.TrialMountStatus,"Mount model already present; M skipped.");return
    end
    state.done=true -- never blindly retry a toggle: a second press can dismount.
    task.spawn(function()
        if not S.Run or not S.TrialMount or LP.Character~=character or not F.inMode("Time Trial") or F.returnButton() then
            state.done=false;return
        end
        local input
        local ok,err=pcall(function()
            input=game:GetService("VirtualInputManager")
            input:SendKeyEvent(true,Enum.KeyCode.M,false,game)
        end)
        if ok then task.wait(0.1) end
        local released,releaseError=pcall(function()
            if input then input:SendKeyEvent(false,Enum.KeyCode.M,false,game) end
        end)
        safeDesc(UI.TrialMountStatus,ok and released and "M sent once; mount activation is not verified."
            or ("M input unavailable/failed: "..tostring(not ok and err or releaseError)))
    end)
end
function F.bestPortal()
    local folder=F.portalFolder() if not folder then return nil end
    local pdata=F.portalMaps()
    local best
    local function ord(r) local d=pdata[r:GetAttribute("MapId")]; return tonumber(d and d.Order) or 0 end
    for _,r in ipairs(folder:GetChildren()) do
        if r:GetAttribute("ModeId")=="Portal" and not r:GetAttribute("Closing") and not r:GetAttribute("Private") and r:GetAttribute("HostId")~=LP.UserId then
            local map=r:GetAttribute("MapId")
            local allowed=pdata[map]~=nil
            if allowed and X.AutoService then
                local ok,v=pcall(function() return X.AutoService.CanFollowInto(Lib.PlayerData,"Portal",map) end)
                allowed=ok and v==true
            end
            if allowed and r:GetAttribute("Status")~="Opened" and not S.PortalRunning then allowed=false end
            if allowed and r:GetAttribute("Status")~="Opened" and X.GamemodeService then
                local ok,v=pcall(function() return X.GamemodeService.CanJoinRunning("Portal",map,r:GetAttribute("Diff"),false) end)
                allowed=ok and v==true
            end
            
            -- Filter Difficulties
            local diff = r:GetAttribute("Diff")
            if allowed and S.PortalAllowedDiffs and #S.PortalAllowedDiffs > 0 then
                if not table.find(S.PortalAllowedDiffs, diff) then
                    allowed = false
                end
            end

            if allowed then
                if not best then best=r
                elseif S.PortalPriority=="Highest Rank" and ord(r)>ord(best) then best=r
                elseif S.PortalPriority=="Lowest Rank" and ord(r)<ord(best) then best=r
