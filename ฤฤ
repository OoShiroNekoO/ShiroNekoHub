        -- Auto Hop Logic
        -- v1.4.47: a hop starts a new client, which forgets in-flight confirmations held in
        -- getgenv. Never hop while a spend/toggle request is still waiting for the game.
        local function pendingWork()
            if S.JewelCraftPending or S.JewelUnequip or S.JewelRestore or S.DeletePending or S.BuffPending or S.RaidHostPending then return true end
            if type(S.ShopPending)=="table" and next(S.ShopPending)~=nil then return true end
            return false
        end
        if S.AutoHop then
            if S.ActiveActivity == "Idle" and pendingWork() then
                S.IdleStartTime = nil
            elseif S.ActiveActivity == "Idle" then
                if not S.IdleStartTime then S.IdleStartTime = os.clock() end
                if os.clock() - S.IdleStartTime >= S.HopDelay then
                    S.IdleStartTime = nil
                    notify("Server Hop", "Hopping server due to idle timeout...")
                    F.hop(S.HopType == "Highest Players")
                end
            else
                S.IdleStartTime = nil
            end
        end

        task.wait(1)
    end
