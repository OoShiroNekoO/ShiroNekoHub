function F.shopTick()
    if not S.Run or not S.Ready then return end
    S.ShopPending=S.ShopPending or {};S.ShopBlocked=S.ShopBlocked or {};S.ShopLast=S.ShopLast or {}
    local now=os.clock()
    local data=Lib.PlayerData
    if type(data)~="table" then return end
    local defs=gd("StockShopData")
    for _,id in ipairs({"Pirate","Time Trial"}) do
        local pending=S.ShopPending[id]
        local state=type(data.StockShops)=="table" and data.StockShops[id]
        local stocks=type(state)=="table" and state.Items
        if pending then
            local stock=type(stocks)=="table" and tonumber(stocks[pending.item])
            if stock and state.Version==pending.version and stock<pending.stock then
                S.ShopPending[id]=nil
                safeDesc(UI.ShopStatus and UI.ShopStatus[id],"Stock decreased after request: "..pending.item)
            elseif now-pending.at>12 then
                S.ShopPending[id]=nil;S.ShopBlocked[id]=true
                safeDesc(UI.ShopStatus and UI.ShopStatus[id],"Purchase unconfirmed; paused. Check game message, then toggle Auto Buy off/on.")
            end
        end
        if S.ShopEnabled[id]==true and not S.ShopPending[id] and not S.ShopBlocked[id] and now-(S.ShopLast[id] or -math.huge)>=S.ShopInterval then
            S.ShopLast[id]=now
            local def=defs[id]
            local selections=S.ShopItems[id]
            if type(def)=="table" and type(def.Items)=="table" and type(stocks)=="table" and type(selections)=="table" then
                local balance=type(data.Items)=="table" and tonumber(data.Items[def.Currency])
                local status="No selected item with stock and enough currency."
                local stockService=gs("StockShopService")
                local versionOK,version=pcall(function() return stockService.GetVersion(def) end)
                if not versionOK or state.Version~=version then
                    status="Waiting for current shop stock version; open this shop in game."
                elseif balance and balance==balance and balance>=0 then
                    for _,item in ipairs(selections) do
                        local row=def.Items[item]
                        local stock=tonumber(stocks[item])
                        local price=type(row)=="table" and tonumber(row.Price)
                        if price and price>0 and stock and stock>=1 then
                            local count=math.floor(math.min(S.ShopQuantity,stock,balance/price))
                            if count>=1 then
                                if fire("StockShopSystem","Buy",id,item,count) then
                                    S.ShopPending[id]={item=item,stock=stock,version=state.Version,at=now}
                                    status="Requested "..count.." x "..item.."; waiting for stock update."
                                end
                                break
                            end
                        end
                    end
                else status="Waiting for currency data: "..tostring(def.Currency) end
                safeDesc(UI.ShopStatus and UI.ShopStatus[id],status)
            else safeDesc(UI.ShopStatus and UI.ShopStatus[id],"Waiting for shop data / item selection. Open this shop once if data is missing.") end
        end
    end
end

