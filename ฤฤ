local function clone(v)
    if type(v)~="table" then return v end
    local t={}
    for k,x in pairs(v) do t[k]=clone(x) end
    return t
end

local function loadcfg()
    local c=clone(D)
    local file=(isfile and isfile(CFGFILE) and CFGFILE) or (isfile and isfile(OLDCFG) and OLDCFG)
    if file and readfile then
        local ok,r=pcall(readfile,file)
        if ok then
            local ok2,t=pcall(function() return HS:JSONDecode(r) end)
            if ok2 and type(t)=="table" then
                for k,v in pairs(t) do
                    if D[k]~=nil and type(v)==type(D[k]) then c[k]=v end
                end
            end
        end
    end
    if type(c.BuiltInAutos)~="table" then c.BuiltInAutos={} end
    if type(c.GameSettings)~="table" then c.GameSettings={} end
    if type(c.FarmTargets)~="table" then c.FarmTargets={"*"} end
    if type(c.PortalAllowedDiffs)~="table" then c.PortalAllowedDiffs={} end
    if type(c.ActivityOrder)~="table" then c.ActivityOrder=clone(D.ActivityOrder) end
    if type(c.ActivityAllowed)~="table" then c.ActivityAllowed=clone(D.ActivityAllowed) end
    local valid={Fragment=true,Trial=true,Raid=true,Invasion=true,Portal=true,Farm=true}
    local out,seen={},{}
    for _,x in ipairs(c.ActivityOrder) do
        if valid[x] and not seen[x] then out[#out+1]=x seen[x]=true end
    end
    for _,x in ipairs(D.ActivityOrder) do
        if not seen[x] then out[#out+1]=x seen[x]=true end
    end
    c.ActivityOrder=out
    for key,range in pairs({ShopQuantity={1,10},ShopInterval={2,60},TrialDistance={2,25},ReturnDelay={0,10},WalkSpeed={8,250},FlySpeed={10,400},InventoryEquipInterval={1,300},HeroInterval={1,300},JewelCraftTier={1,6},DeleteCount={1,500},FarmDistance={-12,12},FarmHeight={-8,12},FarmRadius={5,100},FarmDrift={2,20},FarmWarpInterval={.5,10},Transparency={0,.8},HopDelay={10,3600},RaidLeaveWave={1,100},TowerLeaveFloor={0,100}}) do
        local n=tonumber(c[key])
        if not n or n~=n or math.abs(n)==math.huge then n=D[key] end
        c[key]=math.clamp(n,range[1],range[2])
    end
    if c.FarmMode~="Group Center" and c.FarmMode~="Single Target" then c.FarmMode="Group Center" end
    for key,value in pairs(c.InventoryEquipBindings) do
        if type(key)~="string" or type(value)~="string" or value=="" then c.InventoryEquipBindings[key]=nil end
    end
    for key,value in pairs(c.InventoryEquipEnabled) do
        if type(key)~="string" or type(value)~="boolean" then c.InventoryEquipEnabled[key]=nil end
    end
    for _,slot in ipairs({"Accessories","Warriors","Weapons","Pets","Jewels"}) do
        local n=tonumber(c.InventoryEquipIntervals[slot])
        if not n or n~=n or math.abs(n)==math.huge then n=c.InventoryEquipInterval end
        c.InventoryEquipIntervals[slot]=math.clamp(math.floor(n),1,300)
    end
    for _,key in ipairs({"DeleteCategories","InventoryEquipEnabled","ShopEnabled","BuiltInAutos","GameSettings","ActivityAllowed"}) do
        for id,value in pairs(c[key]) do
            if type(id)~="string" or type(value)~="boolean" then c[key][id]=nil end
        end
    end
    local targets={}
    for _,id in ipairs(c.FarmTargets) do
        if type(id)=="string" or type(id)=="number" then targets[#targets+1]=tostring(id) end
    end
    -- Empty targets cannot be chosen in this UI. Recover an old initialization wipe.
    c.FarmTargets=#targets>0 and targets or {"*"}
    for _,key in ipairs({"DeleteRarities","ShopItems"}) do
        for id,values in pairs(c[key]) do
            if type(id)~="string" or type(values)~="table" then c[key][id]=nil end
        end
    end
    c.JewelCraftTier=math.floor(c.JewelCraftTier)
    local types={}
    for _,v in ipairs(c.JewelCraftTypes) do if type(v)=="string" then types[#types+1]=v end end
    c.JewelCraftTypes=types
    return c
end

