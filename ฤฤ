function F.raidReady()
    if not S.AutoRaidJoin or not X.GamemodeService or F.modeOwnsMovement() or F.trialUrgent() then return false end
    local maps=X.GamemodeData and X.GamemodeData.Raid
    if type(maps)~="table" or type(maps[S.RaidMap])~="table" then
        safeDesc(UI.RaidStatus,"Select a Raid map detected from game data.");return false
    end
    if os.clock()-(S.LastRaid or 0)<10 then return false end
    local ok,window=pcall(function()
        local diffs=X.GamemodeService.GetDiffs("Raid",S.RaidMap)
        if type(diffs)~="table" or not table.find(diffs,S.RaidDiff) then return nil end
        return X.GamemodeService.GetWindow("Raid",S.RaidMap,S.RaidDiff)
    end)
    local ready=ok and type(window)=="table" and window.Open==true
    safeDesc(UI.RaidStatus,ready and "Raid window open." or "Waiting for a supported open Raid window.")
    return ready
end
function F.enterRaid()
    if not F.raidReady() or LP:GetAttribute("Teleporting") or S.ItemBusy or F.returnButton() or os.clock()<S.ModePendingUntil then return end
    S.LastRaid=os.clock()
    -- v1.4.49: UI Create button sends Enter(Mode,Map,Diff) for scheduled modes (no auto flag).
    if fire("GamemodeSystem","Enter","Raid",S.RaidMap,S.RaidDiff) then
        S.ModePendingUntil=os.clock()+8
        safeDesc(UI.RaidStatus,"Entry requested; waiting for game confirmation (not live-tested).")
    end
end
function F.invasionReady()
    if not S.AutoInvasionJoin or not X.GamemodeService or F.modeOwnsMovement() or F.trialUrgent() then return false end
    local now=os.clock()
    if S.LastInvasion and now-S.LastInvasion<10 then return false end
    if not S.InvasionWindow or now-S.InvasionWindow.at>=1 or S.InvasionWindow.diff~=S.InvasionDiff then
        local ok,w=pcall(function() return X.GamemodeService.GetWindow("Invasion","Marine Invasion",S.InvasionDiff) end)
        S.InvasionWindow={at=now,diff=S.InvasionDiff,open=ok and w and w.Open==true or false}
        safeDesc(UI.InvasionStatus,S.InvasionWindow.open and "Marine Invasion is open." or "Waiting for Marine Invasion opening.")
    end
    return S.InvasionWindow.open
end

function F.currentActivity()
    if F.trialUrgent() then return "TrialPreempt" end
    S.TrialExitAttempt=nil
    if S.ItemBusy or LP:GetAttribute("Teleporting")==true then return "Busy" end
    if F.returnButton() then return "Results" end
    if F.inMode("Time Trial") then
        -- A live character in a confirmed Trial no longer waits out the entry timer.
        local h=hum()
        if not root() or not h or h.Health<=0 then return "Busy" end
        S.ModePendingUntil=0
        if S.TrialWalk then return "TrialCombat" end
        return "Idle"
    end
    if S.RaidHostPending then
        if S.AutoRaidHost and S.RaidHostCombat and F.inMode("Raid") then return "RaidCombat" end
        return "RaidHosting"
    end
    if S.TowerHostPending then
        if S.AutoTowerHost and S.TowerHostCombat and F.inMode("Tower") then return "TowerCombat" end
        return "TowerHosting"
    end
    if os.clock()<S.ModePendingUntil then return "Busy" end
    if F.inMode("Portal") then return "PortalActive" end
    if F.modeOwnsMovement() then return "ModeActive" end
    if S.ActivityAllowed.Invasion~=false and F.invasionReady() then return "Invasion" end
    -- Ticket hosting must not be starved indefinitely by a persistent world task.
    if S.AutoRaidHost and S.ActivityAllowed.Raid~=false and F.raidHostReady() then return "Raid" end
    if S.AutoTowerHost and F.towerHostReady() then return "TowerHost" end
    for _,name in ipairs(S.ActivityOrder) do
        if F.activityReady(name) then return name=="Farm" and S.AutoSecret and "SecretFarm" or name end
    end
    return "Idle"
end

