function F.setActivityPriority(pos,value)
    if type(value)~="string" then return end
    local old=S.ActivityOrder[pos]
    if old==value then return end
    local other=table.find(S.ActivityOrder,value)
    if other then S.ActivityOrder[other]=old end
    S.ActivityOrder[pos]=value
    save()
    if UI.PriorityDropdowns then
        UI.ActivityUpdating=true
        if other and UI.PriorityDropdowns[other] then pcall(function() UI.PriorityDropdowns[other]:Select(old) end) end
        UI.ActivityUpdating=false
    end
    safeDesc(UI.ActivityStatus,"Order: "..activityOrderText())
end

-- Mode ownership outranks lobby task preferences, including manual Portal entry.
function F.modeOwnsMovement()
    if F.inMode("Portal") or F.inMode("Time Trial") or F.inMode("Raid") or F.inMode("Invasion") or F.inMode("Tower") then return true end
    for _,key in ipairs({"Mode","InMode"}) do
        local value=LP:GetAttribute(key)
        if value~=nil and value~=false and value~="" and value~=0 then return true end
    end
    return false
end
function F.farmMovementBlocked()
    return LP:GetAttribute("Teleporting")==true or os.clock()<S.ModePendingUntil
        or F.trialUrgent() or F.modeOwnsMovement() or F.returnButton()~=nil
end
function F.activityReady(name)
    if S.ActivityAllowed[name]==false then return false end
    if name=="Fragment" then
        return S.AutoCommandment and F.commandmentItem()~=nil and LP:GetAttribute("Teleporting")~=true
    elseif name=="Trial" then
        if not S.AutoTimeTrial or not X.GamemodeService or F.inMode("Time Trial") or F.modeOwnsMovement() or LP:GetAttribute("Teleporting") then return false end
        -- Use the first currently open supported tier; this lets a newly added T3 run
        -- even when the saved tier is still an older closed value.
        return F.trialOpenTarget()~=nil
    elseif name=="Raid" then
        if S.AutoRaidHost then return F.raidHostReady() end
        return F.raidReady()
    elseif name=="Invasion" then
        return F.invasionReady()
    elseif name=="Portal" then
        if not S.AutoPortal or F.inMode("Portal") or F.modeOwnsMovement() or LP:GetAttribute("Teleporting") then return false end
        return F.bestPortal()~=nil
    elseif name=="Farm" then
        return (S.TPFarm or S.AutoSecret) and not S.ItemBusy and not F.farmMovementBlocked()
    end
    return false
end

