local function findInstancePath(parent,path)
    local node=parent
    for part in string.gmatch(path,"[^%.]+") do
        node=node and node:FindFirstChild(part)
        if not node then return nil end
    end
    return node
end

local function magicKnightModule(name)
    local path=MagicKnightPaths[name]
    return path and findInstancePath(RS,path) or nil
end

local function visibleGuiObject(obj)
    local node=obj
    local pg=LP:FindFirstChild("PlayerGui")
    while node and node~=pg do
        if node:IsA("GuiObject") and node.Visible~=true then return false end
        if node:IsA("ScreenGui") and node.Enabled~=true then return false end
        node=node.Parent
    end
    return node==pg
end

local function guiButtonText(button)
    local out={}
    local function add(node)
        local ok,value=pcall(function() return node.Text end)
        if ok and type(value)=="string" and value~="" then out[#out+1]=value end
    end
    add(button)
    for _,node in ipairs(button:GetDescendants()) do
        if node:IsA("TextLabel") or node:IsA("TextButton") or node:IsA("TextBox") then add(node) end
    end
    return table.concat(out," ")
end

local function normalizedText(value)
    return tostring(value or ""):lower():gsub("%s+"," "):gsub("^%s+",""):gsub("%s+$","")
end

local function findGuiButton(labels)
    local pg=LP:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local rootGui=pg:FindFirstChild("CenterGUI")
    if not rootGui then return nil end
    local wanted={}
    for _,label in ipairs(labels or {}) do wanted[#wanted+1]=normalizedText(label) end
    for _,node in ipairs(rootGui:GetDescendants()) do
        if node:IsA("GuiButton") and node.Name~="Template" and visibleGuiObject(node) then
            local text=normalizedText(guiButtonText(node))
            if text~="" then
                for _,label in ipairs(wanted) do
                    if text==label or string.find(text,label,1,true) then return node end
                end
            end
        end
    end
end

local function activateGuiButton(button)
    if not button or not button.Parent or not visibleGuiObject(button) then return false,"button_hidden" end
    local active=true
    pcall(function() active=button.Active and button.Interactable~=false end)
    if not active then return false,"button_inactive" end
    local ok,err=pcall(function() button:Activate() end)
    if ok then return true,"Activate" end
    local signalFire=ENV.firesignal or firesignal
    local connections=ENV.getconnections or getconnections
    if type(signalFire)~="function" or type(connections)~="function" then return false,tostring(err) end
    for _,signal in ipairs({button.Activated,button.MouseButton1Click}) do
        local okList,list=pcall(connections,signal)
        if okList and type(list)=="table" then
            for _,connection in ipairs(list) do
                local readable,enabled=pcall(function() return connection.Enabled end)
                if readable and enabled~=false then
                    local sent=pcall(signalFire,signal)
                    if sent then return true,"firesignal" end
                end
            end
        end
    end
    return false,tostring(err or "no_click_handler")
end

