function F.setSelectedEquipAutos(want)
    if S.EquipApplyBusy then return end
    S.EquipApplyBusy=true
    task.spawn(function()
        local changed,selected=0,0
        local ok,err=xpcall(function()
            local used={}
            for _,id in pairs(S.EquipAutoMap or {}) do
                if not S.Run then break end
                if S.EquipAutoSelection[tostring(id)]==true and not used[id] then
                    used[id]=true;selected=selected+1
                    local row=X.AutoData[id]
                    if type(row)=="table" and row.Kind=="Toggle" then
                        S.BuiltInAutos[id]=want
                        if autoState(id)~=want and fire("AutoSystem","Toggle",id) then changed=changed+1 end
                        task.wait(.15)
                    end
                end
            end
            save()
        end,debug.traceback)
        S.EquipApplyBusy=false
        if not S.Run then return end
        if not ok then S.LastError=tostring(err);notify("Equip Best",tostring(err))
        elseif selected==0 then notify("Equip Best","Select at least one detected category first")
        else notify("Equip Best",tostring(changed).." toggle requests submitted; verify status in the game's Auto menu") end
    end)
end

-- Screenshot-style switches bind only to an unambiguous live AutoData row.
local EquipmentDefs={
    {key="Weapons",title="Equip Best Weapons",words={"weapon"},action="equip"},
    {key="Accessories",title="Equip Best Accessories",words={"accessor"},action="equip"},
    {key="Pets",title="Equip Best Pets",words={"pet"},action="equip"},
    {key="MergeWeapons",title="Automatically Merge Weapons",words={"weapon"},action="merge"},
    {key="Power",id="AutoEquipGacha",title="Auto Equip Power",words={"power"},action="equip"},
    {key="Avatar",id="AutoEquipAvatar",title="Auto Equip Avatar",words={"avatar"},action="equip"},
    {key="IgnoreLevel",id="AutoEquipAvatarIgnoreLevel",title="Ignore Level"},
}
function F.equipmentCandidates(def)
    if def.id then
        local row=(X.AutoData or {})[def.id]
        return type(row)=="table" and row.Kind=="Toggle" and {def.id} or {}
    end
    local matches={}
    for id,row in pairs(X.AutoData or {}) do
        if type(row)=="table" and row.Kind=="Toggle" then
            local text=(tostring(id).." "..tostring(row.Name or "").." "..tostring(row.Title or "").." "..tostring(row.Parent or "")):lower()
            local category=false
            for _,word in ipairs(def.words) do if text:find(word,1,true) then category=true end end
            local action=text:find(def.action,1,true)~=nil
            if def.key=="Weapons" or def.key=="Accessories" or def.key=="Pets" then action=action and text:find("best",1,true)~=nil end
            if category and action then matches[#matches+1]=id end
        end
    end
    return matches
end
function F.setEquipmentRow(row,value,desc,locked)
    if not row then return end
    S.EquipmentHydrating=true
    local ok,err=pcall(function()
        row:Set(value==true)
        row:SetDesc(desc)
        if locked then row:Lock() else row:Unlock() end
    end)
    S.EquipmentHydrating=false
    if not ok then S.LastError=tostring(err) end
end
function F.refreshEquipmentRows()
    if not UI.EquipmentRows then return end
    S.EquipmentBindings={}
    local found,enabled=0,0
    local state=Lib.PlayerData and Lib.PlayerData.AutoSettings
    for _,def in ipairs(EquipmentDefs) do
        local candidates=F.equipmentCandidates(def)
        local row=UI.EquipmentRows[def.key]
        if #candidates==1 and type(state)=="table" then
            local id=candidates[1];S.EquipmentBindings[def.key]=id
            found=found+1;if state[id]==true then enabled=enabled+1 end
            F.setEquipmentRow(row,state[id],"Native game automation: "..tostring(id),false)
        else
            local reason=#candidates==0 and "Unavailable: no matching native automation detected." or (#candidates>1 and "Unavailable: multiple matching native actions; select the exact action in native Auto settings." or "Waiting for player AutoSettings. Refresh after the game loads.")
            F.setEquipmentRow(row,false,reason,true)
        end
    end
    safeDesc(UI.EquipmentSummary,tostring(enabled).." native equipment autos ON / "..found.." supported rows.")
end
function F.toggleEquipmentRow(key,want)
    if not S.Run or not S.Ready or S.UIHydrating or S.EquipmentHydrating then return end
    local id=S.EquipmentBindings and S.EquipmentBindings[key]
    if not id then F.refreshEquipmentRows();return end
    S.EquipmentPending=S.EquipmentPending or {}
    if S.EquipmentPending[id] then return end
    S.BuiltInAutos[id]=want==true;save()
    if autoState(id)==want then F.refreshEquipmentRows();return end
    if not fire("AutoSystem","Toggle",id) then F.refreshEquipmentRows();return end
    S.EquipmentPending[id]=true
    F.setEquipmentRow(UI.EquipmentRows[key],want,"Request sent; waiting for replicated state...",true)
    task.delay(2.1,function()
        if not S.Run then return end
        S.EquipmentPending[id]=nil
        local applied=autoState(id)==want
        F.refreshEquipmentRows()
        if not applied then
            safeDesc(UI.EquipmentRows[key],"Not confirmed by game; no automatic retry. Check native Auto settings.")
            S.LastError="Equipment toggle not confirmed: "..tostring(id)
        end
    end)
end
