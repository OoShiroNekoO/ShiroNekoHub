                if S.OldFPSBoostSettings[v]==nil then S.OldFPSBoostSettings[v]=v.CastShadow end
                v.CastShadow=false
            end
        end
    elseif S.FPSApplied then
        L.GlobalShadows=S.OriginalGlobalShadows
        if S.OriginalQuality~=nil then pcall(function() settings().Rendering.QualityLevel=S.OriginalQuality end) end
        for v,value in pairs(S.OldFPSBoostSettings) do
            if v.Parent then pcall(function() if v:IsA("BasePart") then v.CastShadow=value else v.Enabled=value end end) end
